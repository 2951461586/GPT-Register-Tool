<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SmsWorkbench.WebHost</AssemblyName>
    <RootNamespace>SmsWorkbench.WebHost</RootNamespace>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SmsWorkbench.Contracts\SmsWorkbench.Contracts.csproj" />
  </ItemGroup>
  <Target Name="BuildWebUi" BeforeTargets="Publish">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\webui" Command="npm install --no-audit --no-fund" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\webui" Command="npm run build" />
  </Target>
</Project>
