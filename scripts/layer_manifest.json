{
  "_why": "Module-level layer map for sms_tool. Numbering follows docs/architecture.md: layer 1 is the outermost surface, layer 5 the innermost adapter. Imports point inward, so an edge may go from a lower layer to a higher one, never the reverse. A module no rule claims fails the check, so the map cannot silently lose coverage. Enforced by scripts/import_layer_ratchet.py.",
  "layers": {
    "1": "surface (IPC envelope, operator output, stdout mirror, WPF-facing reads)",
    "2": "command adapter (cli, cli_parsers, commands, doctor, diagnostics)",
    "3": "application workflow (registration, payment, mailbox, accounts, auth)",
    "4": "domain contract (shared seams, config, kernel, models)",
    "5": "adapter (providers, store, payment lanes, drivers, facades)"
  },
