    "sms_tool.paypal -> sms_tool.paypal.orchestrator": {
      "reason": "the paypal package __init__ re-exports its own browser-lane orchestrator; a package facade is the documented import surface (ADR-0009)",
      "owner": "sms_tool/paypal/__init__.py"
    },
    "sms_tool.registration_drivers.playwright -> sms_tool.registration_drivers.browser_flow": {
      "reason": "the playwright driver shell drives the browser_flow workflow; the shell is a registration_drivers member, so the package layer is one below the flow it owns",
