{
  "$schema": "https://raw.githubusercontent.com/apmantza/pi-lens/master/docs/schema/pi-lens-config-v1.json",
  "format": {
    "enabled": false
  },
  "rules": {
    "python-hardcoded-secrets": {
      "ignorePaths": [
        "services/protocol-payment/**",
        "sms_tool/**",
        "tests/**"
      ]
    },
    "python-unsafe-regex": {
      "ignorePaths": [
        "services/protocol-payment/**",
        "sms_tool/**",
        "tests/**"
      ]
    }
  },
  "ignore": [
    "sms_tool/upi_link/_vendor/**",
    "scripts/**",
    "dist/**",
    "runtime/**",
    "sessions/**",
    ".dotnet/**",
    ".workbuddy/**",
    ".workbuddy-ai/**",
    "SmsWorkbench/bin/**",
    "SmsWorkbench/obj/**",
    "SmsWorkbench.Contracts/bin/**",
    "SmsWorkbench.Contracts/obj/**",
    "tests/**/bin/**",
    "tests/**/obj/**"
  ]
}
