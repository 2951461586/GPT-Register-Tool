# Copy to .env for local driver configuration. Never commit .env.
# Existing process environment variables take precedence over this file.

# Sentinel Node SDK runner
OPENAI_SENTINEL_BACKEND=node_runner
OPENAI_SENTINEL_LEGACY_FALLBACK=true
OPENAI_SENTINEL_NODE_PATH=
OPENAI_SENTINEL_VERSION=

