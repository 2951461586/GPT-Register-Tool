<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SmsWorkbench.Views">
  <local:NavKeyEqualsConverter x:Key="NavKeyEqualsConverter"/>
  <local:NavCancelAlertConverter x:Key="NavCancelAlertConverter"/>

  <!-- Preserved for backward resource compatibility (checked by DesktopWindowSmokeTests) -->
  <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Background" Value="{DynamicResource SidebarButtonBg}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Corner.Md}">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SidebarHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SidebarPressed}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
    <Setter Property="Margin" Value="10,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
        <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="IconNavButtonStyle" TargetType="local:IconNavButton">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="0,0,0,1"/>
    <Setter Property="Height" Value="29"/>
    <Setter Property="Padding" Value="10,0,10,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}"/>
    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="IsActive">
      <Setter.Value>
        <MultiBinding Converter="{StaticResource NavKeyEqualsConverter}">
          <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/>
          <Binding Path="ActiveKey" RelativeSource="{RelativeSource AncestorType=local:Sidebar}"/>
        </MultiBinding>
      </Setter.Value>
    </Setter>
    <Setter Property="IsAlert">
      <Setter.Value>
        <MultiBinding Converter="{StaticResource NavCancelAlertConverter}">
          <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/>
          <Binding Path="ActiveKey" RelativeSource="{RelativeSource AncestorType=local:Sidebar}"/>
        </MultiBinding>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:IconNavButton">
          <Grid x:Name="RowRoot" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="{StaticResource Corner.Md}"/>
            <Border x:Name="HoverFill"
                    Background="{DynamicResource SidebarHover}"
                    CornerRadius="{StaticResource Corner.Md}"
                    Opacity="0"
                    IsHitTestVisible="False"/>
            <Border x:Name="PressedFill"
                    Background="{DynamicResource SidebarPressed}"
                    CornerRadius="{StaticResource Corner.Md}"
                    Opacity="0"
                    IsHitTestVisible="False"/>
            <Grid>
              <Border x:Name="SelectionBar"
                      Width="3"
                      Margin="0,7"
                      HorizontalAlignment="Left"
                      CornerRadius="{StaticResource Corner.Hairline}"
                      Background="{DynamicResource AccentIndicator}"
                      Visibility="Collapsed"/>
              <Grid x:Name="ContentGrid" Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path x:Name="Glyph"
                      Grid.Column="0"
                      Style="{StaticResource NavIconPath}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="{TemplateBinding IconGeometry}"/>
                <TextBlock x:Name="Label"
                           Grid.Column="1"
                           Text="{TemplateBinding Text}"
                           Style="{DynamicResource SidebarLabelStyle}"
                           FontSize="{StaticResource Type.Body.Size}"
                           Foreground="{DynamicResource TextMain}"
                           VerticalAlignment="Center"/>
              </Grid>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
              <Setter TargetName="ContentGrid" Property="Margin" Value="0"/>
              <Setter TargetName="ContentGrid" Property="HorizontalAlignment" Value="Center"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource TextMain}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill"
                                     Storyboard.TargetProperty="Opacity"
                                     To="1"
                                     Duration="0:0:0.09">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0"
                                     Duration="0:0:0.14">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressedFill"
                                     Storyboard.TargetProperty="Opacity"
                                     To="1"
                                     Duration="0:0:0.06"/>
                    <DoubleAnimation Storyboard.TargetName="RowRoot"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="0.985"
                                     Duration="0:0:0.06"/>
                    <DoubleAnimation Storyboard.TargetName="RowRoot"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="0.985"
                                     Duration="0:0:0.06"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressedFill"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0"
                                     Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetName="RowRoot"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1"
                                     Duration="0:0:0.10"/>
                    <DoubleAnimation Storyboard.TargetName="RowRoot"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1"
                                     Duration="0:0:0.10"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsActive" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Card}"/>
              <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource AccentIndicator}"/>
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextMain}"/>
              <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsAlert" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DangerSoft}"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
              <Setter TargetName="Chrome" Property="BorderThickness" Value="1"/>
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Danger}"/>
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Danger}"/>
              <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="RowRoot" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Compact utility button for the bottom Shell / Theme / Language dock -->
  <Style x:Key="SidebarUtilityDockButtonStyle" TargetType="local:IconNavButton" BasedOn="{StaticResource IconNavButtonStyle}">
    <Setter Property="Height" Value="30"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:IconNavButton">
          <Grid x:Name="RowRoot">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource Corner.Md}"/>
            <Border x:Name="HoverFill" Background="{DynamicResource SidebarHover}" CornerRadius="{StaticResource Corner.Md}" Opacity="0" IsHitTestVisible="False"/>
            <Border x:Name="PressedFill" Background="{DynamicResource SidebarPressed}" CornerRadius="{StaticResource Corner.Md}" Opacity="0" IsHitTestVisible="False"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
              <Path x:Name="Glyph"
                    Style="{StaticResource IconPath}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="{TemplateBinding IconGeometry}"/>
              <TextBlock x:Name="Label"
                         Text="{TemplateBinding Text}"
                         FontSize="{StaticResource Type.Caption.Size}"
                         Foreground="{DynamicResource TextSub}"
                         Margin="5,0,0,0"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource TextMain}"/>
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextMain}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Normal}">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PressedFill" Property="Opacity" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SidebarToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
    <Setter Property="Grid.Column" Value="1"/>
    <Setter Property="Grid.ColumnSpan" Value="1"/>
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="4,0,0,0"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource Corner.Md}"/>
            <Border x:Name="HoverFill" Background="{DynamicResource SidebarHover}" CornerRadius="{StaticResource Corner.Md}" Opacity="0" IsHitTestVisible="False"/>
            <Border x:Name="PressedFill" Background="{DynamicResource SidebarPressed}" CornerRadius="{StaticResource Corner.Md}" Opacity="0" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="HoverFill" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PressedFill" Property="Opacity" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
        <Setter Property="Grid.Column" Value="0"/>
        <Setter Property="Grid.ColumnSpan" Value="2"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SidebarScrollBarStyle" TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Visibility" Value="Collapsed"/>
  </Style>

  <Style x:Key="SidebarSectionHeaderStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    <Setter Property="FontSize" Value="{StaticResource Type.Micro.Size}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="10,5,8,2"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextAlignment" Value="Left"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
        <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SidebarGroupDividerStyle" TargetType="Border">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource Divider}"/>
    <Setter Property="Margin" Value="8,6,8,4"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
        <Setter Property="Visibility" Value="Visible"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
