<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!--
    Core typography, focus ring, text box, scrollbar, splitter, tooltip, and icon
    styles for the workbench shell. Domain-specific button, input/selector, and
    data-grid styles live in Controls.Buttons.xaml, Controls.Inputs.xaml, and
    Controls.DataGrid.xaml (merged in App.xaml immediately after this file).
  -->

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
  </Style>

  <Style x:Key="Text.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{StaticResource Type.Subtitle.Size}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
  </Style>

  <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{StaticResource Type.Caption.Size}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
  </Style>

  <Style x:Key="FocusRingStyle">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-2"
                     RadiusX="{StaticResource Radius.Sm}"
                     RadiusY="{StaticResource Radius.Sm}"
                     SnapsToDevicePixels="True"
                     Stroke="{DynamicResource FocusRing}"
                     StrokeThickness="2"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{StaticResource Type.Caption.Size}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
    <Setter Property="Margin" Value="{StaticResource Space.Bottom1}"/>
  </Style>

  <Style x:Key="IconPath" TargetType="Path">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Stroke" Value="{DynamicResource TextSub}"/>
    <Setter Property="StrokeThickness" Value="1.6"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="Fill" Value="Transparent"/>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
    <Setter Property="FontSize" Value="{StaticResource Type.Body.Size}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="BoxChrome" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Corner.Md}">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="BoxChrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="BoxChrome" Property="BorderBrush" Value="{DynamicResource FocusRing}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MultilineTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Height">
      <Setter.Value>
        <sys:Double>NaN</sys:Double>
      </Setter.Value>
    </Setter>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="AcceptsReturn" Value="True"/>
  </Style>

  <Style x:Key="StableScrollBarThumbStyle" TargetType="Thumb">
    <Setter Property="MinWidth" Value="{StaticResource Size.ScrollBar.Thumb}"/>
    <Setter Property="MinHeight" Value="{StaticResource Size.ScrollBar.ThumbMinLength}"/>
    <Setter Property="Background" Value="{DynamicResource LineStrong}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Background="Transparent">
            <Border x:Name="ThumbChrome"
                    Margin="2"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource Corner.Xs}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource TextMuted}"/>
              <Setter TargetName="ThumbChrome" Property="Margin" Value="1"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource TextSub}"/>
              <Setter TargetName="ThumbChrome" Property="Margin" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}"
                   Value="Horizontal">
        <Setter Property="MinWidth" Value="{StaticResource Size.ScrollBar.ThumbMinLength}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.ScrollBar.Thumb}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="StableScrollBarPageButtonStyle" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="StableScrollBarStyle" TargetType="ScrollBar">
    <Setter Property="Width" Value="{StaticResource Size.ScrollBar.Track}"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track"
                   IsDirectionReversed="True"
                   Orientation="{TemplateBinding Orientation}">
              <Track.DecreaseRepeatButton>
                <RepeatButton x:Name="DecreasePageButton"
                              Command="{x:Static ScrollBar.PageUpCommand}"
                              Style="{StaticResource StableScrollBarPageButtonStyle}"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource StableScrollBarThumbStyle}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton x:Name="IncreasePageButton"
                              Command="{x:Static ScrollBar.PageDownCommand}"
                              Style="{StaticResource StableScrollBarPageButtonStyle}"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Width" Value="Auto"/>
              <Setter Property="Height" Value="{StaticResource Size.ScrollBar.Track}"/>
              <Setter Property="MinWidth" Value="24"/>
              <Setter Property="MinHeight" Value="0"/>
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
              <Setter TargetName="DecreasePageButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
              <Setter TargetName="IncreasePageButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource StableScrollBarStyle}"/>

  <Style TargetType="GridSplitter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridSplitter">
          <Grid Background="{TemplateBinding Background}">
            <Border x:Name="Grip"
                    Width="{StaticResource Size.Splitter.GripLength}"
                    Height="{StaticResource Size.Splitter.GripThickness}"
                    CornerRadius="{StaticResource Corner.Hairline}"
                    Background="{DynamicResource LineStrong}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ResizeDirection" Value="Columns">
              <Setter TargetName="Grip" Property="Width" Value="{StaticResource Size.Splitter.GripThickness}"/>
              <Setter TargetName="Grip" Property="Height" Value="{StaticResource Size.Splitter.GripLength}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Grip" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Grip" Property="Opacity" Value="1"/>
              <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentIndicator}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">12</sys:Double>
  <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">12</sys:Double>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Surface.Card}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="FontSize" Value="{StaticResource Type.Body.Size}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Corner.Sm}"
                  Padding="{TemplateBinding Padding}">
            <Border.Effect>
              <DropShadowEffect Color="#33000000" BlurRadius="10" ShadowDepth="1" Direction="270"/>
            </Border.Effect>
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MenuIconPath" TargetType="Path">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Stroke" Value="{DynamicResource TextSub}"/>
    <Setter Property="StrokeThickness" Value="1.4"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="Fill" Value="Transparent"/>
  </Style>

  <Style x:Key="ToolbarIconPath" TargetType="Path" BasedOn="{StaticResource MenuIconPath}">
    <Setter Property="Width" Value="13"/>
    <Setter Property="Height" Value="13"/>
    <Setter Property="StrokeThickness" Value="1.5"/>
  </Style>

  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
</ResourceDictionary>
