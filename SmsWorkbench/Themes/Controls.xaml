<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Implicit and keyed control styles/templates for the workbench shell. Split out of
    App.xaml on 2026-10-23; colours moved to Themes/Colors.{Light,Dark}.xaml and the
    spacing/radius/type scale to Themes/Tokens.xaml on 2026-10-28.

    Every colour reference here is DynamicResource so the runtime dictionary swap
    reaches it. StaticResource into Tokens.xaml is deliberate and safe: App.xaml
    merges Tokens before this file, and a reorder fails loudly at first parse rather
    than silently falling back to a WPF default.

    Radii come from the Radius/Corner tokens (chosen by the control's shortest side);
    no bare CornerRadius literal belongs in this file.
  -->

      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      </Style>

      <!-- ═══ Type ramp ════════════════════════════════════════════════════
           Five steps, each a token. A view that needs another size adds a token
           (and a reason) instead of writing FontSize="13" at the call site. -->
      <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Type.Display.Size}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      </Style>

      <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Type.Title.Size}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      </Style>

      <Style x:Key="Text.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Type.Subtitle.Size}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      </Style>

      <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Type.Body.Size}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      </Style>

      <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Type.Caption.Size}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
      </Style>

      <!-- ═══ Keyboard focus ═══════════════════════════════════════════════
           The one border a surface may add besides inputs and the chrome edge.
           Buttons used to set FocusVisualStyle={x:Null}, which left keyboard
           users with no landing point at all. -->
      <Style x:Key="FocusRingStyle">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Rectangle Margin="-2"
                         RadiusX="{StaticResource Radius.Sm}"
                         RadiusY="{StaticResource Radius.Sm}"
                         SnapsToDevicePixels="True"
                         Stroke="{DynamicResource FocusRing}"
                         StrokeThickness="2"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Caption.Size}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="4,12,0,6"/>
      </Style>

      <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Type.Caption.Size}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
        <Setter Property="Margin" Value="{StaticResource Space.Bottom1}"/>
      </Style>

      <!-- Modernized Button Style -->
      <Style TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="3,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="ButtonChrome"
                       Background="{TemplateBinding Background}"
                       BorderBrush="{TemplateBinding BorderBrush}"
                       BorderThickness="{TemplateBinding BorderThickness}"
                       CornerRadius="{StaticResource Corner.Md}">
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource Surface.Block}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!--
        PrimaryButton is the ONE filled action a screen is for (FlClash's rule: colour
        marks the action, not the structure). It used to be neutral on purpose, which
        left every dialog with no visual answer to "which button confirms this".
      -->
      <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>

      <!-- SecondaryButton Style for neutral dialog actions -->
      <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
      </Style>

      <!-- DangerButton: tint the text and the outline, not the fill. A solid red
           block competes with the primary action it sits next to. -->
      <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
      </Style>

      <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
      </Style>

      <Style x:Key="SidebarIconButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
      </Style>

      <Style x:Key="PagerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="3,0"/>
        <Setter Property="Padding" Value="10,0"/>
      </Style>

      <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{DynamicResource TextSub}"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
      </Style>

      <!-- Modernized TextBox: an input is one of the three things allowed to keep a
           stroke, and it only fully states it on focus (the other two are the focus
           ring and the chrome edge). -->
      <Style TargetType="TextBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="BoxChrome" Background="{TemplateBinding Background}"
                       BorderBrush="{TemplateBinding BorderBrush}"
                       BorderThickness="{TemplateBinding BorderThickness}"
                       CornerRadius="{StaticResource Corner.Md}">
                <ScrollViewer x:Name="PART_ContentHost"
                               Margin="{TemplateBinding Padding}"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                               HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                               VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="BoxChrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="BoxChrome" Property="BorderBrush" Value="{DynamicResource FocusRing}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ════════════════════════════════════════════════════════════════
           Modernized ComboBox — full custom ControlTemplate
           Matches TextBox/Button design language: CornerRadius=6, same
           semantic brushes, hover/focus states, custom chevron glyph,
           rounded popup with shadow, styled item hover & selected.
           ════════════════════════════════════════════════════════════════ -->

      <!-- ToggleButton used inside ComboBox (provides the chevron) -->
      <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
        <Border x:Name="ComboChrome"
                Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource Line}"
                BorderThickness="1"
                CornerRadius="4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>
            <Path x:Name="ArrowGlyph"
                  Grid.Column="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="10" Height="6"
                  Stretch="Uniform"
                  Fill="{DynamicResource TextSub}"
                  Data="M0,0 L5,5 L10,0 Z"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="ComboChrome" Property="Background" Value="{DynamicResource PanelHover}"/>
            <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter TargetName="ArrowGlyph" Property="Fill" Value="{DynamicResource TextMain}"/>
          </Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter TargetName="ArrowGlyph" Property="Fill" Value="{DynamicResource TextMain}"/>
            <Setter TargetName="ArrowGlyph" Property="RenderTransform">
              <Setter.Value>
                <RotateTransform Angle="180" CenterX="5" CenterY="3"/>
              </Setter.Value>
            </Setter>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="ComboChrome" Property="Opacity" Value="0.45"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>

      <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template" Value="{StaticResource ComboBoxToggleButton}"/>
      </Style>

      <!-- App-owned scroll bars avoid WPF-UI brush animations on dynamic theme brushes. -->
      <Style x:Key="StableScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="Background" Value="{DynamicResource LineStrong}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Thumb">
              <Border x:Name="ThumbChrome"
                      Margin="2"
                      Background="{TemplateBinding Background}"
                      CornerRadius="{StaticResource Corner.Full}"/>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource TextMuted}"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                  <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource TextSub}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}"
                       Value="Horizontal">
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="MinHeight" Value="6"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="StableScrollBarPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RepeatButton">
              <Border Background="Transparent"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="PasswordBox">
              <Border x:Name="PasswordChrome"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{StaticResource Corner.Md}">
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="PasswordChrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="PasswordChrome" Property="BorderBrush" Value="{DynamicResource FocusRing}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="StableScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Border Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track"
                       IsDirectionReversed="True"
                       Orientation="{TemplateBinding Orientation}">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton x:Name="DecreasePageButton"
                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                  Style="{StaticResource StableScrollBarPageButtonStyle}"/>
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource StableScrollBarThumbStyle}"/>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton x:Name="IncreasePageButton"
                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                  Style="{StaticResource StableScrollBarPageButtonStyle}"/>
                  </Track.IncreaseRepeatButton>
                </Track>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                  <Setter Property="Width" Value="Auto"/>
                  <Setter Property="Height" Value="10"/>
                  <Setter Property="MinWidth" Value="24"/>
                  <Setter Property="MinHeight" Value="0"/>
                  <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                  <Setter TargetName="DecreasePageButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                  <Setter TargetName="IncreasePageButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource StableScrollBarStyle}"/>

      <Style TargetType="ComboBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="9,0,7,0"/>
        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
              <Grid x:Name="TemplateRoot">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="ToggleButton"
                              Grid.ColumnSpan="2"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press"
                              Style="{StaticResource ComboBoxToggleButtonStyle}"/>
                <ContentPresenter x:Name="ContentSite"
                                  Grid.Column="0"
                                  ClipToBounds="True"
                                  IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                  TextBlock.FontSize="{TemplateBinding FontSize}"/>
                <TextBox x:Name="PART_EditableTextBox"
                         Grid.Column="0"
                         Margin="{TemplateBinding Padding}"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         Focusable="True"
                         Visibility="Hidden"
                         IsReadOnly="{TemplateBinding IsReadOnly}"
                         Foreground="{TemplateBinding Foreground}"
                         BorderThickness="0"
                         Text="{TemplateBinding Text}"/>
                <Popup x:Name="Popup"
                       Grid.ColumnSpan="2"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                       PopupAnimation="None"
                       VerticalOffset="4">
                  <Border Background="{DynamicResource PanelBg}"
                          BorderBrush="{DynamicResource LineStrong}"
                          BorderThickness="1"
                          CornerRadius="4"
                          Width="{Binding ActualWidth, ElementName=TemplateRoot}"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}"
                          Padding="0,4">
                    <Border.Effect>
                      <DropShadowEffect Color="#22000000" BlurRadius="14" ShadowDepth="3" Opacity="0.45" Direction="270"/>
                    </Border.Effect>
                    <ScrollViewer SnapsToDevicePixels="True"
                                  CanContentScroll="True"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                      <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource StableScrollBarStyle}"/>
                      </ScrollViewer.Resources>
                      <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEditable" Value="True">
                  <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBoxItem">
              <Border x:Name="ItemBg"
                      Background="{TemplateBinding Background}"
                      CornerRadius="4"
                      Margin="3,1"
                      Padding="{TemplateBinding Padding}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Grid.Column="0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    TextBlock.Foreground="{TemplateBinding Foreground}"
                                    TextBlock.FontSize="{TemplateBinding FontSize}"/>
                  <!-- Checkmark shown when selected -->
                  <Path x:Name="CheckGlyph"
                        Grid.Column="1"
                        Width="12" Height="9"
                        Margin="8,0,4,0"
                        Stretch="Uniform"
                        Fill="{DynamicResource Success}"
                        Data="M0,4.5 L3.5,8 L9,0.5 L8,0 L3.5,6 L1,3.5 Z"
                        Visibility="Collapsed"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource PanelHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource PrimarySoft}"/>
                  <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource PanelHover}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Modernized DataGrid: a table is read as rows of text, so structure is the
           hover/selection fill; no zebra, no cell borders, no column rules. -->
      <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="Transparent"/>
        <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="ColumnHeaderHeight" Value="32"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="True"/>
      </Style>

      <!--
        Selection keeps the row's own surface and adds a primary bar at its edge.
        A filled grey block (GridSelectionBg #C8C8C8) read as "disabled", and a
        primary wash competed with the status badges sitting in the same row.
      -->
      <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridRow">
              <Border x:Name="RowChrome"
                      Background="{TemplateBinding Background}"
                      CornerRadius="{StaticResource Corner.Xs}"
                      SnapsToDevicePixels="True">
                <Grid>
                  <Border x:Name="SelectionBar"
                          Width="3"
                          HorizontalAlignment="Left"
                          CornerRadius="{StaticResource Corner.Xs}"
                          Background="{DynamicResource Primary}"
                          Visibility="Collapsed"/>
                  <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource Surface.Block}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource Surface.Block}"/>
                  <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridCell">
              <Border Background="{TemplateBinding Background}"
                      BorderThickness="0"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <!-- Selection lives on the row (fill + primary bar); the cell adds nothing,
               otherwise a selected row paints two different greys per column. -->
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Caption.Size}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Height" Value="32"/>
      </Style>

      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>

      <!-- ── Status Badge Style (for DataGrid cells) ── -->
      <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Corner.Xs}"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource BadgeNeutralBg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="success">
            <Setter Property="Background" Value="{DynamicResource BadgeSuccessBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeSuccessBd}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="warn">
            <Setter Property="Background" Value="{DynamicResource BadgeWarnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeWarnBd}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="danger">
            <Setter Property="Background" Value="{DynamicResource BadgeDangerBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeDangerBd}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="info">
            <Setter Property="Background" Value="{DynamicResource BadgeInfoBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeInfoBd}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="StatusBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Type.Caption.Size}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BadgeNeutralFg}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag}" Value="success">
            <Setter Property="Foreground" Value="{DynamicResource BadgeSuccessFg}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag}" Value="warn">
            <Setter Property="Foreground" Value="{DynamicResource BadgeWarnFg}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag}" Value="danger">
            <Setter Property="Foreground" Value="{DynamicResource BadgeDangerFg}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag}" Value="info">
            <Setter Property="Foreground" Value="{DynamicResource BadgeInfoFg}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- ── Icon Button Style (for pagination etc.) ── -->
      <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Margin" Value="2,0"/>
      </Style>

      <!-- ── Search TextBox with icon support ── -->
      <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="28,0,24,0"/>
      </Style>

      <!-- ── Dialog Window shared style ── -->
      <Style x:Key="DialogWindow" TargetType="Window">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="WindowStartupLocation" Value="CenterOwner"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
        <Setter Property="ResizeMode" Value="CanResize"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Window">
              <Border Margin="12" CornerRadius="{StaticResource Corner.Xl}">
                <Border.Effect>
                  <DropShadowEffect Color="#22000000" BlurRadius="16" ShadowDepth="3" Opacity="0.5" Direction="270"/>
                </Border.Effect>
                <Border Background="{DynamicResource Surface.Card}" CornerRadius="{StaticResource Corner.Xl}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="36"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource PanelBg}" CornerRadius="10,10,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                      <Grid>
                        <TextBlock Text="{TemplateBinding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" Margin="16,0,40,0" TextTrimming="CharacterEllipsis"/>
                        <Button Width="36" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="关闭" IsCancel="True">
                          <Button.Template>
                            <ControlTemplate TargetType="Button">
                              <Border x:Name="CloseBg" Background="Transparent" CornerRadius="4">
                                <Path Width="10" Height="10" Stretch="Uniform" Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource TextSub}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="CloseBg" Property="Background" Value="{DynamicResource Danger}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="CloseBg" Property="Child" Value="{x:Null}"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Button.Template>
                        </Button>
                      </Grid>
                    </Border>
                    <ContentPresenter Grid.Row="1"/>
                  </Grid>
                </Border>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    <!-- Icon geometry shared by every stroke-drawn icon: context-menu icons at
         14px / 1.4 and paging-control icons at 13px / 1.5. Each <Path> now only
         carries its own Width/Height/Data. Declared first so every later
         StaticResource and BasedOn lookup resolves. -->
    <Style x:Key="MenuIconPath" TargetType="Path">
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Stroke" Value="{DynamicResource TextSub}"/>
      <Setter Property="StrokeThickness" Value="1.4"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Fill" Value="Transparent"/>
    </Style>
    <Style x:Key="ToolbarIconPath" TargetType="Path" BasedOn="{StaticResource MenuIconPath}">
      <Setter Property="Width" Value="13"/>
      <Setter Property="Height" Value="13"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
    </Style>
  <!-- Shared by UserControls (the account filter bar) that cannot see
       window-level resources while their own XAML is parsed. -->
  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
</ResourceDictionary>
