<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    LIGHT colour scheme. Colors.Dark.xaml carries THE SAME KEY SET — adding a key
    here without adding it there makes the dark theme fall back to a WPF default
    brush (silently), so the two files are edited together.

    Two layers, both intentional:

    * Surface ladder (new). Structure is drawn with a step in lightness, never a
      border: page -> card is lighter, card -> block is darker, block -> inset is
      darker again. Views read Surface.* ; they must not compose their own tints.
    * Legacy semantic aliases (PanelBg / Line / TextMain / GridSelectionBg ...).
      Kept because WindowThemeService reads PanelBg+TextMain for the DWM caption
      and DesktopWindowSmokeTests asserts SettingsSelection* equality. They now
      resolve to the same values as the ladder instead of a separate palette.

    Colour is reserved for state: selected, on, failing, and the one action a
    screen is for. Nothing structural is tinted.
  -->

  <!-- ═══ Surface ladder ══════════════════════════════════════════════════
       94 page / 100 card / 94 block / 92 inset — light alternates paper and
       grey; the card is not tinted, and the chrome sits four tones off the page. -->
  <SolidColorBrush x:Key="Surface.Page" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="Surface.Card" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Surface.Block" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="Surface.Inset" Color="#EAEAEA"/>
  <SolidColorBrush x:Key="Surface.Chrome" Color="#E9E9E9"/>

  <!-- onSurface at 14%: one divider colour that keeps its contrast on the page,
       on a card and on the chrome alike (an opaque grey reads twice as strong on
       the dark theme as on the light one). -->
  <SolidColorBrush x:Key="Divider" Color="#241F2328"/>
  <SolidColorBrush x:Key="FocusRing" Color="#2563EB"/>

  <!-- ═══ Text ladder (three levels, three values) ════════════════════════ -->
  <SolidColorBrush x:Key="TextMain" Color="#1F2328"/>
  <SolidColorBrush x:Key="TextSub" Color="#57606A"/>
  <SolidColorBrush x:Key="TextMuted" Color="#6E7781"/>

  <!-- ═══ Action accent ═══════════════════════════════════════════════════ -->
  <SolidColorBrush x:Key="Primary" Color="#2563EB"/>
  <SolidColorBrush x:Key="PrimarySoft" Color="#EAF2FF"/>
  <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Danger" Color="#B42318"/>
  <SolidColorBrush x:Key="DangerSoft" Color="#FEF0EE"/>
  <SolidColorBrush x:Key="DangerBorder" Color="#F0B8B2"/>
  <SolidColorBrush x:Key="Success" Color="#16794C"/>
  <SolidColorBrush x:Key="SuccessSoft" Color="#EAF7F0"/>
  <SolidColorBrush x:Key="SuccessBorder" Color="#9AD8B7"/>

  <!-- ═══ Legacy aliases (kept; resolve to the ladder) ════════════════════ -->
  <SolidColorBrush x:Key="AppBg" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PanelBg2" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="PanelHover" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="Line" Color="#E2E6EA"/>
  <SolidColorBrush x:Key="LineStrong" Color="#D0D6DC"/>
  <SolidColorBrush x:Key="SidebarBg" Color="#E9E9E9"/>
  <SolidColorBrush x:Key="SidebarButtonBg" Color="Transparent"/>
  <SolidColorBrush x:Key="GridAltBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="GridSelectionBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SettingsSelectionBg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SettingsSelectionBorder" Color="#2563EB"/>
  <SolidColorBrush x:Key="SplitterBg" Color="#E2E6EA"/>
  <SolidColorBrush x:Key="StatusBg" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="LogBg" Color="#EAEAEA"/>
  <SolidColorBrush x:Key="LogBorder" Color="#D0D6DC"/>
  <SolidColorBrush x:Key="LogText" Color="#1F2328"/>

  <!-- ═══ Status badges ═══════════════════════════════════════════════════
       The colour lives on the TEXT (Fg); the container is a soft same-hue wash
       and draws no border. Five containers with one grey foreground — the old
       shape — made all five states read identically at a glance. -->
  <SolidColorBrush x:Key="BadgeSuccessBg" Color="#EFF2F0"/>
  <SolidColorBrush x:Key="BadgeSuccessFg" Color="#2B644A"/>
  <SolidColorBrush x:Key="BadgeSuccessBd" Color="Transparent"/>
  <SolidColorBrush x:Key="BadgeWarnBg" Color="#F4F1EB"/>
  <SolidColorBrush x:Key="BadgeWarnFg" Color="#6D511D"/>
  <SolidColorBrush x:Key="BadgeWarnBd" Color="Transparent"/>
  <SolidColorBrush x:Key="BadgeDangerBg" Color="#F8F4F4"/>
  <SolidColorBrush x:Key="BadgeDangerFg" Color="#933F39"/>
  <SolidColorBrush x:Key="BadgeDangerBd" Color="Transparent"/>
  <SolidColorBrush x:Key="BadgeInfoBg" Color="#F1F4F8"/>
  <SolidColorBrush x:Key="BadgeInfoFg" Color="#4461B1"/>
  <SolidColorBrush x:Key="BadgeInfoBd" Color="Transparent"/>
  <SolidColorBrush x:Key="BadgeNeutralBg" Color="#F2F3F4"/>
  <SolidColorBrush x:Key="BadgeNeutralFg" Color="#5B6066"/>
  <SolidColorBrush x:Key="BadgeNeutralBd" Color="Transparent"/>

  <!-- ═══ Card accents ════════════════════════════════════════════════════ -->
  <SolidColorBrush x:Key="AccentBlue" Color="#2563EB"/>
  <SolidColorBrush x:Key="AccentGreen" Color="#16A34A"/>
  <SolidColorBrush x:Key="AccentOrange" Color="#D97706"/>
  <SolidColorBrush x:Key="AccentPurple" Color="#7C3AED"/>
  <SolidColorBrush x:Key="AccentRed" Color="#DC2626"/>

  <!-- ═══ ComboBox popup keys (read by Controls.xaml's template) ══════════ -->
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#E2E6EA"/>
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#57606A"/>
  <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#2563EB"/>
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#E2E6EA"/>
  <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#6E7781"/>
</ResourceDictionary>
