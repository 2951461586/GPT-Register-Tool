<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    DARK colour scheme. Same key set as Colors.Light.xaml — the two files are one
    contract; see the header there for what each layer is for.

    Dark only ever gets LIGHTER: a darker step inside a lighter surface reads as a
    hole rather than a layer, so page(6) -> card(15) -> block(21) -> inset(27) all
    climb, and the chrome sits just above the page so cards still stand off it.
  -->
  <SolidColorBrush x:Key="Surface.Page" Color="#181818"/>
  <SolidColorBrush x:Key="Surface.Card" Color="#232323"/>
  <SolidColorBrush x:Key="Surface.Block" Color="#2B2B2B"/>
  <SolidColorBrush x:Key="Surface.Inset" Color="#333333"/>
  <SolidColorBrush x:Key="Surface.Chrome" Color="#1E1E1E"/>

  <SolidColorBrush x:Key="Divider" Color="#24E6E6E6"/>
  <SolidColorBrush x:Key="FocusRing" Color="#60A5FA"/>

  <SolidColorBrush x:Key="TextMain" Color="#E6E6E6"/>
  <SolidColorBrush x:Key="TextSub" Color="#A8B0B8"/>
  <SolidColorBrush x:Key="TextMuted" Color="#7D858D"/>

  <SolidColorBrush x:Key="Primary" Color="#3B82F6"/>
  <SolidColorBrush x:Key="PrimarySoft" Color="#172554"/>
  <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Danger" Color="#FA5252"/>
  <SolidColorBrush x:Key="DangerSoft" Color="#2B1D1D"/>
  <SolidColorBrush x:Key="DangerBorder" Color="#8C2A2A"/>
  <SolidColorBrush x:Key="Success" Color="#51CF66"/>
  <SolidColorBrush x:Key="SuccessSoft" Color="#1A2E1F"/>
  <SolidColorBrush x:Key="SuccessBorder" Color="#2B6B3A"/>

  <SolidColorBrush x:Key="AppBg" Color="#181818"/>
  <SolidColorBrush x:Key="PanelBg" Color="#232323"/>
  <SolidColorBrush x:Key="PanelBg2" Color="#2B2B2B"/>
  <SolidColorBrush x:Key="PanelHover" Color="#2B2B2B"/>
  <SolidColorBrush x:Key="Line" Color="#333333"/>
  <SolidColorBrush x:Key="LineStrong" Color="#454545"/>
  <SolidColorBrush x:Key="SidebarBg" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="SidebarButtonBg" Color="Transparent"/>
  <SolidColorBrush x:Key="GridAltBg" Color="#232323"/>
  <SolidColorBrush x:Key="GridSelectionBg" Color="#232323"/>
  <SolidColorBrush x:Key="SettingsSelectionBg" Color="#2B2B2B"/>
  <SolidColorBrush x:Key="SettingsSelectionBorder" Color="#3B82F6"/>
  <SolidColorBrush x:Key="SplitterBg" Color="#333333"/>
  <SolidColorBrush x:Key="StatusBg" Color="#181818"/>
  <SolidColorBrush x:Key="LogBg" Color="#2B2B2B"/>
  <SolidColorBrush x:Key="LogBorder" Color="#3A3A3A"/>
  <SolidColorBrush x:Key="LogText" Color="#E6E6E6"/>

  <SolidColorBrush x:Key="BadgeSuccessBg" Color="#123524"/>
  <SolidColorBrush x:Key="BadgeSuccessFg" Color="#51CF66"/>
  <SolidColorBrush x:Key="BadgeSuccessBd" Color="Transparent"/>
  <SolidColorBrush x:Key="BadgeWarnBg" Color="#3A2B0B"/>
  <SolidColorBrush x:Key="BadgeWarnFg" Color="#FBBF24"/>
  <SolidColorBrush x:Key="BadgeWarnBd" Color="Transparent"/>
  <SolidColorBrush x:Key="BadgeDangerBg" Color="#3B1717"/>
  <SolidColorBrush x:Key="BadgeDangerFg" Color="#FA5252"/>
  <SolidColorBrush x:Key="BadgeDangerBd" Color="Transparent"/>
  <SolidColorBrush x:Key="BadgeInfoBg" Color="#172554"/>
