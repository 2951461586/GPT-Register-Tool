<Window x:Class="SmsWorkbench.Dialogs.InfoConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:SmsWorkbench.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        MinWidth="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel VerticalAlignment="Center" Margin="0,0,0,16">
      <TextBlock x:Name="TitleTextBlock"
                 FontSize="{StaticResource Type.Title.Size}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextMain}"
                 Margin="0,0,0,8"/>
      <TextBlock x:Name="MessageTextBlock"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSub}"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton"
              Content="{loc:Tr Key='取消'}"
              Width="76"
              Margin="0,0,8,0"
              IsCancel="True"
              Visibility="Collapsed"
              Click="CancelButton_Click"/>
      <Button x:Name="ConfirmButton"
              Content="{loc:Tr Key='知道了'}"
              MinWidth="88"
              IsDefault="True"
              Style="{StaticResource PrimaryButton}"
              Click="ConfirmButton_Click"/>
    </StackPanel>
  </Grid>
</Window>
