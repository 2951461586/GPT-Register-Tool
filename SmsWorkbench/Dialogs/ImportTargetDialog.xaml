<Window x:Class="SmsWorkbench.Dialogs.ImportTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:SmsWorkbench.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360"
        Height="190"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="{loc:Tr Key='选择导入目标'}"
               Foreground="{DynamicResource TextMain}"
               FontWeight="SemiBold"
               Margin="0,0,0,10"/>

    <ComboBox x:Name="TargetComboBox"
              Grid.Row="1"
              SelectedIndex="0"
              Margin="0,0,0,18">
      <ComboBoxItem Content="CPA" Tag="cpa"/>
      <ComboBoxItem Content="SUB2API" Tag="sub2api"/>
    </ComboBox>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{loc:Tr Key='取消'}"
              Width="76"
              Margin="0,0,8,0"
              IsCancel="True"
              Click="Cancel_Click"/>
      <Button Content="{loc:Tr Key='确定'}"
              Width="76"
              IsDefault="True"
              Style="{StaticResource PrimaryButton}"
              Click="Ok_Click"/>
    </StackPanel>
  </Grid>
</Window>
