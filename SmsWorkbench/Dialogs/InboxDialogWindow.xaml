<Window x:Class="SmsWorkbench.Dialogs.InboxDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:SmsWorkbench.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="860"
        Height="640"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock x:Name="HeaderTextBlock"
                 Text="{loc:Tr Key='正在加载收件箱...'}"
                 FontSize="{StaticResource Type.Subtitle.Size}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextMain}"/>
    </StackPanel>

    <DataGrid x:Name="MailDataGrid"
              Grid.Row="1"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              HeadersVisibility="Column"
              IsReadOnly="True"
              RowHeight="28"
              EnableRowVirtualization="True"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              GridLinesVisibility="Horizontal"
              AlternatingRowBackground="{DynamicResource GridAltBg}"
              Background="{DynamicResource PanelBg}"
              Foreground="{DynamicResource TextMain}"
              BorderThickness="0"
              MouseDoubleClick="MailDataGrid_MouseDoubleClick">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{loc:Tr Key='时间'}" Binding="{Binding ReceivedAt}" Width="150"/>
        <DataGridTextColumn Header="{loc:Tr Key='发件人'}" Binding="{Binding From}" Width="200"/>
        <DataGridTextColumn Header="{loc:Tr Key='主题'}" Binding="{Binding Subject}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,8,0,0">
      <Button Content="{loc:Tr Key='刷新'}"
              Width="72"
              Click="RefreshButton_Click"/>
      <Button Content="{loc:Tr Key='关闭'}"
              Width="72"
              Click="CloseButton_Click"/>
    </StackPanel>
  </Grid>
</Window>
