<Window x:Class="SmsWorkbench.Dialogs.ChangeEmailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:SmsWorkbench.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Tr Key='邮箱换绑'}"
        Width="460"
        Height="360"
        MinWidth="440"
        MinHeight="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">
  <StackPanel Margin="20">
    <TextBlock x:Name="ProviderLabelTextBlock"
               Margin="0,0,0,6"
               Foreground="{DynamicResource TextMain}"/>
    <ComboBox x:Name="ProviderComboBox"
              Width="260"
              HorizontalAlignment="Left"
              SelectedIndex="0"
              Margin="0,0,0,10">
      <ComboBoxItem Content="ReMail" Tag="remail"/>
      <ComboBoxItem Content="{loc:Tr Key='CF Worker 域名邮箱'}" Tag="cfworker"/>
      <ComboBoxItem Content="Smailr" Tag="smailr"/>
      <ComboBoxItem Content="{loc:Tr Key='iCloud 邮箱池'}" Tag="icloud"/>
      <ComboBoxItem Content="{loc:Tr Key='Outlook 邮箱池'}" Tag="outlook"/>
      <ComboBoxItem Content="{loc:Tr Key='Hotmail 邮箱池'}" Tag="hotmail"/>
    </ComboBox>

    <TextBlock Text="{loc:Tr Key='并发数'}"
               Foreground="{DynamicResource TextMain}"/>
    <TextBox x:Name="WorkerTextBox"
             Width="260"
             HorizontalAlignment="Left"
             Margin="0,0,0,10"/>

    <TextBlock Text="{loc:Tr Key='iCloud/Outlook/Hotmail 需提供等量凭证文件'}"
               Foreground="{DynamicResource TextSub}"/>
    <StackPanel Orientation="Horizontal">
      <TextBox x:Name="FileTextBox"
               Width="210"
               Margin="0,0,8,10"/>
      <Button Content="{loc:Tr Key='选择凭证文件'}"
              Margin="0,0,0,10"
              Click="BrowseButton_Click"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{loc:Tr Key='取消'}"
              Width="80"
              IsCancel="True"
              Margin="0,0,8,0"
              Click="CancelButton_Click"/>
      <Button Content="{loc:Tr Key='开始'}"
              Width="80"
              IsDefault="True"
              Style="{StaticResource PrimaryButton}"
              Click="OkButton_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
