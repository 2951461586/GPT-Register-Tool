<Window x:Class="SmsWorkbench.Dialogs.AccountScanResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:SmsWorkbench.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="740"
        MinWidth="740"
        SizeToContent="Height"
        MaxHeight="760"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock x:Name="HeaderTitleTextBlock"
                 FontSize="{StaticResource Type.Title.Size}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextMain}"/>
      <TextBlock x:Name="SummaryTextBlock"
                 Margin="0,6,0,0"
                 Foreground="{DynamicResource TextSub}"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1"
                  MaxHeight="520"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="BodyStackPanel"/>
    </ScrollViewer>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="{loc:Tr Key='关闭'}"
              Width="82"
              IsDefault="True"
              IsCancel="True"
              Style="{StaticResource PrimaryButton}"
              Click="Close_Click"/>
    </StackPanel>
  </Grid>
</Window>
