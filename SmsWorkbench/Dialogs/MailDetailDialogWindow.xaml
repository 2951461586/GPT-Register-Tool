<Window x:Class="SmsWorkbench.Dialogs.MailDetailDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:SmsWorkbench.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720"
        Height="460"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="SubjectTextBlock"
               Grid.Row="0"
               FontSize="{StaticResource Type.Subtitle.Size}"
               FontWeight="SemiBold"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextMain}"/>

    <TextBlock x:Name="MetaTextBlock"
               Grid.Row="1"
               Margin="0,6,0,10"
               Foreground="{DynamicResource TextSub}"/>

    <TextBox x:Name="BodyTextBox"
             Grid.Row="2"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Disabled"
             VerticalContentAlignment="Top"
             Height="NaN"
             Background="{DynamicResource PanelBg}"
             Foreground="{DynamicResource TextMain}"
             BorderBrush="{DynamicResource Line}"/>

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,10,0,0">
      <Button x:Name="CopyCodeButton"
              MinWidth="120"
              Click="CopyCodeButton_Click"/>
      <Button Content="{loc:Tr Key='复制正文'}"
              Width="86"
              Click="CopyBodyButton_Click"/>
      <Button Content="{loc:Tr Key='关闭'}"
              Width="72"
              Click="CloseButton_Click"/>
    </StackPanel>
  </Grid>
</Window>
