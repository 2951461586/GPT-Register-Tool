<Window x:Class="SmsWorkbench.AccountDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:SmsWorkbench.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="960"
        Height="740"
        MinWidth="780"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">
  <!-- Converted from the hand-built Grid in `MainWindow.ShowAccountDetailAsync`
       on 2026-11-20. Row 2 (the PayPal URL panel) is always present and collapses
       when the row has no link, so the row indices stay fixed. -->
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="{Binding Identifier}"
                 FontSize="{StaticResource Type.Title.Size}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextMain}"
                 VerticalAlignment="Center"/>
      <Border Background="{DynamicResource PrimarySoft}"
              CornerRadius="{StaticResource Corner.Xs}"
              Padding="8,2"
              Margin="12,0,0,0"
              VerticalAlignment="Center"
              Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding Status}"
                   FontSize="{StaticResource Type.Caption.Size}"
                   Foreground="{DynamicResource TextSub}"/>
      </Border>
    </StackPanel>

    <ItemsControl Grid.Row="1" ItemsSource="{Binding SummaryItems}" Margin="0,0,0,12">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="2"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="{DynamicResource Surface.Card}"
                  CornerRadius="{StaticResource Corner.Xl}"
                  Padding="12,8"
                  Margin="0,0,6,6">
            <StackPanel>
              <TextBlock Text="{Binding Label}"
                         FontSize="{StaticResource Type.Caption.Size}"
                         Foreground="{DynamicResource TextMuted}"
                         Margin="0,0,0,4"/>
              <TextBlock Text="{Binding Value}"
                         FontSize="{StaticResource Type.Body.Size}"
                         FontWeight="Medium"
                         Foreground="{DynamicResource TextMain}"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Grid.Row="2"
            Background="{DynamicResource Surface.Card}"
            CornerRadius="{StaticResource Corner.Xl}"
            Padding="12,6"
            Margin="0,0,0,10"
            Visibility="{Binding HasPayPalUrl, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="{loc:Tr Key='支付订阅链接'}"
                   FontSize="{StaticResource Type.Caption.Size}"
                   Foreground="{DynamicResource TextMuted}"
                   Margin="0,0,0,4"/>
        <TextBox Text="{Binding PayPalUrl}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 Background="Transparent"
                 Foreground="{DynamicResource TextSub}"
                 FontSize="{StaticResource Type.Body.Size}"
                 Padding="0"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="3"
            Background="{DynamicResource Surface.Inset}"
            CornerRadius="{StaticResource Corner.Xl}"
            Margin="0,0,0,10">
      <TextBox Text="{Binding DetailText}"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               FontFamily="Consolas"
               FontSize="{StaticResource Type.Body.Size}"
               Foreground="{DynamicResource TextMain}"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               MinHeight="200"
               Background="Transparent"
               BorderThickness="0"
               Padding="10,8,10,8"/>
    </Border>

    <Grid Grid.Row="4" Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal">
        <Button Content="{loc:Tr Key='打开源文件'}" MinWidth="100" Margin="0,0,8,0" Click="OpenSourceFile_Click"/>
        <Button x:Name="CopyAccessTokenButton"
                Content="{loc:Tr Key='一键复制AT'}"
                MinWidth="100"
                Margin="0,0,8,0"
                IsEnabled="{Binding HasAccessToken}"
                Click="CopyAccessToken_Click"/>
        <Button Content="{loc:Tr Key='账号测活'}" MinWidth="100" Margin="0,0,8,0" Click="CheckAlive_Click"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{loc:Tr Key='打开支付链接'}"
                MinWidth="120"
                Margin="0,0,8,0"
                IsEnabled="{Binding HasPayPalUrl}"
                Click="OpenPayPal_Click"/>
        <Button Content="{loc:Tr Key='复制支付链接'}"
                MinWidth="120"
                Margin="0,0,8,0"
                IsEnabled="{Binding HasPayPalUrl}"
                Click="CopyPayPal_Click"/>
        <Button Content="{loc:Tr Key='关闭'}" MinWidth="80" Click="Close_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
