<Window x:Class="SmsWorkbench.StageMatrixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实时阶段矩阵"
        Width="1180" Height="620" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBg}">
  <Window.Resources>
    <Style x:Key="StageCellBorder" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="running"><Setter Property="BorderBrush" Value="#D89B22"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="completed"><Setter Property="Background" Value="#173E2C"/><Setter Property="BorderBrush" Value="#2E9B63"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="failed"><Setter Property="Background" Value="#4A2020"/><Setter Property="BorderBrush" Value="#D25555"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="cancelled"><Setter Property="BorderBrush" Value="#8B8B8B"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="实时阶段矩阵" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center"/>
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Runs}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="{Binding AccountRef}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountRef}"/>
                  <TextBlock Foreground="{DynamicResource TextSub}" FontSize="11">
                    <Run Text="{Binding DomainLabel}"/><Run Text=" · "/><Run Text="{Binding Method}"/><Run Text=" · "/><Run Text="{Binding Elapsed}"/>
                  </TextBlock>
                  <TextBlock Text="{Binding CurrentStage}" FontFamily="Consolas" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StageCellBorder}" MinWidth="92" ToolTip="{Binding Detail}">
                        <StackPanel>
                          <TextBlock Text="{Binding Stage}" FontFamily="Consolas" FontSize="10" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                          <TextBlock Text="{Binding AttemptText}" FontSize="10" Foreground="{DynamicResource TextSub}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="关闭" MinWidth="76" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
