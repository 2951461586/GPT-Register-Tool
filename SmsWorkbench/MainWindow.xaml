<ui:FluentWindow x:Class="SmsWorkbench.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:SmsWorkbench"
                 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                 Title="GPT Register Tool"
                 Width="1360" Height="860" MinWidth="1220" MinHeight="720"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource AppBg}"
                 FontFamily="Segoe UI, Microsoft YaHei UI"
                 FontSize="13"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
  <ui:FluentWindow.Resources>
    <local:CollapsedLabelConverter x:Key="CollapsedLabelConverter"/>
    <local:StatusSeverityConverter x:Key="StatusSeverityConverter"/>
    <local:RtDisplayConverter x:Key="RtDisplayConverter"/>
    <Style x:Key="SidebarNavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="{DynamicResource SidebarButtonBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelHover}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
          <Setter Property="Width" Value="46"/>
          <Setter Property="HorizontalAlignment" Value="Center"/>
          <Setter Property="HorizontalContentAlignment" Value="Center"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0,0,0,8"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarPaneBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SidebarBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="12"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
          <Setter Property="Padding" Value="7"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarBrandLogoStyle" TargetType="Border">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarBrandTextPanelStyle" TargetType="StackPanel">
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
          <Setter Property="Grid.Column" Value="0"/>
          <Setter Property="Grid.ColumnSpan" Value="3"/>
          <Setter Property="Width" Value="40"/>
          <Setter Property="Height" Value="40"/>
          <Setter Property="Margin" Value="0"/>
          <Setter Property="HorizontalAlignment" Value="Center"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarScrollBarStyle" TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarSectionHeaderStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="4,18,0,8"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="AccountContextMenuStyle" TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="5"/>
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border x:Name="MenuChrome"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    SnapsToDevicePixels="True">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccountContextMenuItemStyle" TargetType="MenuItem">
      <Setter Property="MinWidth" Value="232"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="ItemChrome"
                    Height="{TemplateBinding Height}"
                    Background="Transparent"
                    Padding="8,0,12,0"
                    SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="IconPresenter"
                                  Grid.Column="0"
                                  ContentSource="Icon"
                                  Width="16" Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  SnapsToDevicePixels="True"/>
                <TextBlock x:Name="HeaderText"
                           Grid.Column="2"
                           Text="{TemplateBinding Header}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           Foreground="{TemplateBinding Foreground}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           SnapsToDevicePixels="True"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource PanelHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemChrome" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </ui:FluentWindow.Resources>
      <Grid Background="{DynamicResource AppBg}">
        <Grid.RowDefinitions>
          <RowDefinition Height="48"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

      <!-- Custom TitleBar with SVG icon buttons -->
      <Grid Grid.Row="0" Height="48" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- App title (left side, optional) -->
        <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource TextMuted}"
                   Text="GRT"/>

        <!-- Window control buttons -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
          <!-- Minimize button -->
          <Button x:Name="MinimizeButton"
                  Width="46" Height="32"
                  WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="MinimizeButton_Click"
                  ToolTip="最小化"
                  BorderThickness="0" Padding="0"
                  Background="Transparent">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="BtnBg" Background="Transparent">
                  <Path Width="12" Height="1" Stretch="Uniform"
                        Data="M 0,0.5 L 12,0.5"
                        Stroke="{DynamicResource TextSub}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource PanelHover}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>

          <!-- Maximize/Restore button -->
          <Button x:Name="MaximizeButton"
                  Width="46" Height="32"
                  WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="MaximizeButton_Click"
                  ToolTip="最大化"
                  BorderThickness="0" Padding="0"
                  Background="Transparent">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="BtnBg" Background="Transparent">
                  <Path x:Name="MaxIcon" Width="12" Height="12" Stretch="Uniform"
                        Data="M 1,3 L 1,1 L 9,1 L 9,3 M 1,1 L 1,9 L 9,9 L 9,1"
                        Stroke="{DynamicResource TextSub}"
                        StrokeThickness="1.2"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource PanelHover}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>

          <!-- Close button -->
          <Button x:Name="CloseButton"
                  Width="46" Height="32"
                  WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="CloseButton_Click"
                  ToolTip="关闭"
                  BorderThickness="0" Padding="0"
                  Background="Transparent">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="BtnBg" Background="Transparent">
                  <Path x:Name="CloseIcon" Width="10" Height="10" Stretch="Uniform"
                        Data="M 0,0 L 10,10 M 10,0 L 0,10"
                        Stroke="{DynamicResource TextSub}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource Danger}"/>
                    <Setter TargetName="CloseIcon" Property="Stroke" Value="#FFFFFF"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SidebarColumn" Width="272"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="SidebarHost" Grid.Column="0" Margin="10,0,10,10" ClipToBounds="True" HorizontalAlignment="Stretch">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Margin="0,0,0,10"
                  Style="{StaticResource SidebarPaneBorderStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource SidebarBrandLogoStyle}">
                <Image Source="Assets/black-kitten.png" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Style="{StaticResource SidebarBrandTextPanelStyle}" Margin="10,0,8,0">
                <TextBlock Text="GPT Register Tool" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button x:Name="SidebarToggleButton"
                      Grid.Column="2"
                      Style="{StaticResource SidebarToggleButtonStyle}"
                      ToolTip="收起侧边栏"
                      Click="ToggleSidebar_Click">
                <Path Width="16"
                      Height="16"
                      Stretch="Uniform"
                      Data="{Binding SidebarToggleGeometry}"
                      Stroke="{DynamicResource TextSub}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
              </Button>
            </Grid>
          </Border>

          <Border Grid.Row="1"
                  Style="{StaticResource SidebarPaneBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
              <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SidebarScrollBarStyle}"/>
              </ScrollViewer.Resources>
              <StackPanel>
                <TextBlock Text="一键操作" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="OneClickRegister_Click">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M16 16v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 8a4 4 0 1 0 0-8 4 4 0 0 0 0 8 M22 16v-1 M19 13h6"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="一键注册" Style="{StaticResource SidebarLabelStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="OneClickSms_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="一键接码" Style="{StaticResource SidebarLabelStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="OneClickScan_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M3 3v18h18 M7 14l4-4 4 4 5-5"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="账号测活" Style="{StaticResource SidebarLabelStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="CheckPromotion_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7 M15 3h6v6 M10 14L21 3"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="查优惠" Style="{StaticResource SidebarLabelStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>

                <TextBlock Text="支付管理" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="OpenPayPalLink_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="打开支付链接" Style="{StaticResource SidebarLabelStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="MarkPayPalComplete_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M22 11.08V12a10 10 0 1 1-5.93-9.14 M22 4L12 14.01l-3-3"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="标记支付完成" Style="{StaticResource SidebarLabelStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>
                <Button x:Name="BatchPaymentButton" AutomationProperties.Name="批量协议支付" Style="{StaticResource SidebarNavButtonStyle}" Click="BatchProtocolPayment_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M4 5h16 M4 12h16 M4 19h16 M8 3v4 M8 10v4 M8 17v4"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="批量协议支付" Style="{StaticResource SidebarLabelStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>
                <TextBlock Text="邮箱管理" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="ImportChataiMailbox_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22 6l-10 7L2 6"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="导入邮箱" Style="{StaticResource SidebarLabelStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="ViewInbox_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22 6l-10 7L2 6 M2 18h20"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="查看收件箱" Style="{StaticResource SidebarLabelStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>

                <TextBlock Text="账号管理" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="ImportPaidCpa_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M12 3v12 M8 11l4 4 4-4 M20 21H4"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="一键导入" Style="{StaticResource SidebarLabelStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="ExportAccounts_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M12 21V9 M16 13l-4-4-4 4 M4 3h16"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="导出账号" Style="{StaticResource SidebarLabelStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="DeleteSelected_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M10 11v6 M14 11v6"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="删除选中" Style="{StaticResource SidebarLabelStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>

                <TextBlock Text="项目设置" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="Refresh_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M23 4v6h-6 M1 20v-6h6 M3.51 9a9 9 0 0 1 14.85-3.36L23 10 M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="刷新" Style="{StaticResource SidebarLabelStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>
                <Button x:Name="SettingsButton" AutomationProperties.Name="设置" Style="{StaticResource SidebarNavButtonStyle}" Click="Settings_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="设置" Style="{StaticResource SidebarLabelStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="ToggleTheme_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                      <Path x:Name="ThemeIcon" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="{Binding ThemeIconGeometry}"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="切换主题" Style="{StaticResource SidebarLabelStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="CancelBatch_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z M15 9l-6 6 M9 9l6 6"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="取消批次" Style="{StaticResource SidebarLabelStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

        <Grid Grid.Column="1" Margin="14,0,14,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="320" MinHeight="240"/>
            <RowDefinition Height="24"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="14,12" CornerRadius="8" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentBlue}" Margin="0,0,10,0"/>
                <StackPanel>
                  <TextBlock Text="总记录" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding TotalCountText}" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="0,0,8,0" Padding="14,12" CornerRadius="8" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentOrange}" Margin="0,0,10,0"/>
                <StackPanel>
                  <TextBlock Text="已接码" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding MailboxCountText}" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="0,0,8,0" Padding="14,12" CornerRadius="8" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentGreen}" Margin="0,0,10,0"/>
                <StackPanel>
                  <TextBlock Text="已注册" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding RegisteredCountText}" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Margin="0,0,8,0" Padding="14,12" CornerRadius="8" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentPurple}" Margin="0,0,10,0"/>
                <StackPanel>
                  <TextBlock Text="支付完成" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding PaypalCountText}" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Padding="14,12" CornerRadius="8" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentRed}" Margin="0,0,10,0"/>
                <StackPanel>
                  <TextBlock Text="异常/待处理" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding AttentionCountText}" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>

          <Border Grid.Row="1" Margin="0,0,0,10" Padding="12" CornerRadius="8" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0" MinWidth="460">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="260"/>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="96"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                  <TextBox Style="{StaticResource SearchTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索邮箱、session、token、备注"/>
                  <Path Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                        Data="M11 3a8 8 0 1 0 0 16 8 8 0 0 0 0-16z M21 21l-4.35-4.35"
                        Stroke="{DynamicResource TextMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                        IsHitTestVisible="False"/>
                  <Button x:Name="SearchClearButton" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                          Padding="0" Background="Transparent" BorderThickness="0" ToolTip="清除搜索"
                          Click="SearchClear_Click" Visibility="Collapsed">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="ClearBg" Background="Transparent" CornerRadius="10">
                          <Path Width="10" Height="10" Stretch="Uniform" Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                Stroke="{DynamicResource TextMuted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ClearBg" Property="Background" Value="{DynamicResource PanelHover}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </Grid>
                <ComboBox Grid.Column="1" Margin="8,0,0,0"
                          SelectedItem="{Binding ScopeFilter, Mode=TwoWay}"
                          ToolTip="筛选范围">
                  <sys:String>全部</sys:String>
                  <sys:String>邮箱池</sys:String>
                  <sys:String>已注册</sys:String>
                  <sys:String>待处理</sys:String>
                </ComboBox>
                <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding PageSizeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="每页条数"/>
                <TextBlock Grid.Column="3" Margin="12,0,0,0" Text="{Binding PageStatusText}" VerticalAlignment="Center" Foreground="{DynamicResource TextSub}"/>
              </Grid>
              <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Margin="2,0" Click="FirstPage_Click" ToolTip="首页">
                  <Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                        Data="M11 19l-7-7 7-7 M19 19l-7-7 7-7"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="2,0" Click="PrevPage_Click" ToolTip="上一页">
                  <Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                        Data="M15 18l-6-6 6-6"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="2,0" Click="ClearSelection_Click" ToolTip="清空选择">
                  <StackPanel Orientation="Horizontal">
                    <Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                          Data="M9 11l3 3l8-8 M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                    <TextBlock Text="清空" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="2,0" Click="NextPage_Click" ToolTip="下一页">
                  <Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                        Data="M9 18l6-6-6-6"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="2,0" Click="LastPage_Click" ToolTip="末页">
                  <Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                        Data="M13 5l7 7-7 7 M5 5l7 7-7 7"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="6,0,2,0" Click="SelectAllFiltered_Click" ToolTip="选中当前筛选结果">
                  <StackPanel Orientation="Horizontal">
                    <Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                          Data="M9 11l3 3l8-8 M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                    <TextBlock Text="全选" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                  </StackPanel>
                </Button>
              </WrapPanel>
            </Grid>
          </Border>

          <Border Grid.Row="2" Margin="0,0,0,10" Padding="0" CornerRadius="8" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <DataGrid x:Name="AccountGrid"
                      ItemsSource="{Binding PagedRows}"
                      SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="28"
                      BorderThickness="0"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      EnableColumnVirtualization="True"
                      Sorting="AccountGrid_Sorting"
                      SelectionChanged="AccountGrid_SelectionChanged">
              <DataGrid.ContextMenu>
                <ContextMenu Style="{StaticResource AccountContextMenuStyle}">
                  <MenuItem Header="查看账号详情" Click="CtxViewDetail_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                            Data="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="查看邮箱收件箱" Click="CtxViewInbox_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                            Data="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22 6l-10 7L2 6"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Header="复制邮箱地址" Click="CtxCopyEmail_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                            Data="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="复制 AT" Click="CtxCopyAccessToken_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                            Data="M15 7a5 5 0 1 0-4.9 6H13l2 2 2-2 2 2 3-3-4-4h-3z"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="复制支付链接" Click="CtxCopyPayPal_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                            Data="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="打开支付链接" Click="CtxOpenPayPal_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                            Data="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6 M15 3h6v6 M10 14L21 3"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="批量协议支付" Click="CtxBatchProtocolPayment_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                            Data="M4 5h16 M4 12h16 M4 19h16 M8 3v4 M8 10v4 M8 17v4"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Header="测活当前账号" Click="CtxCheckAccountAlive_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                            Data="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8 M21 3v5h-5"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Header="打开 Session 源文件" Click="CtxOpenSource_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                            Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="标记为支付完成" Click="CtxMarkPayPal_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                            Data="M22 11.08V12a10 10 0 1 1-5.93-9.14 M22 4L12 14.01l-3-3"/>
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="选中" Binding="{Binding IsChecked}" Width="60"/>
                <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt}" Width="155" IsReadOnly="True"/>
                <DataGridTextColumn Header="更新时间" Binding="{Binding CompletedAt}" Width="155" IsReadOnly="True"/>
                <DataGridTextColumn Header="邮箱" Binding="{Binding Identifier}" Width="260" IsReadOnly="True"/>
                <DataGridTextColumn Header="账号类型" Binding="{Binding AccountPlanType}" Width="92" IsReadOnly="True"/>
                <DataGridTextColumn Header="注册区" Binding="{Binding RegistrationCountry}" Width="64" IsReadOnly="True"/>
                <DataGridTextColumn Header="类型" Binding="{Binding AccountType}" Width="120" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="状态" Width="130" IsReadOnly="True" SortMemberPath="Status" CanUserSort="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusBadge}" Tag="{Binding Status, Converter={StaticResource StatusSeverityConverter}}">
                        <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="AT" Width="86" IsReadOnly="True" SortMemberPath="AccessTokenStatus" CanUserSort="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusBadge}" Tag="{Binding AccessTokenStatus, Converter={StaticResource StatusSeverityConverter}}">
                        <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding AccessTokenStatus}" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="RT" Width="78" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusBadge}" Tag="{Binding RefreshTokenStatus, Converter={StaticResource StatusSeverityConverter}}">
                        <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding RefreshTokenStatus, Converter={StaticResource RtDisplayConverter}}" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="2FA" Width="84" IsReadOnly="True" SortMemberPath="TwoFactorStatus" CanUserSort="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusBadge}" Tag="{Binding TwoFactorStatus, Converter={StaticResource StatusSeverityConverter}}">
                        <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding TwoFactorStatus}" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="优惠状态" Width="150" IsReadOnly="True" SortMemberPath="PromotionStatus" CanUserSort="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusBadge}" Tag="{Binding PromotionStatus, Converter={StaticResource StatusSeverityConverter}}">
                        <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding PromotionStatus}" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="详情" Width="80">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Height="24" Padding="6,0" Click="AccountDetail_Click" ToolTip="查看详情">
                        <StackPanel Orientation="Horizontal">
                          <Path Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                Data="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/>
                          <TextBlock Text="查看" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>

          <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource SplitterBg}" ShowsPreview="True"/>

          <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="64" MinHeight="42"/>
              <RowDefinition Height="5"/>
              <RowDefinition Height="*" MinHeight="200"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="0" CornerRadius="8" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <DataGrid x:Name="TaskGrid"
                        ItemsSource="{Binding Tasks}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        RowHeight="26"
                        BorderThickness="0"
ScrollViewer.HorizontalScrollBarVisibility="Auto"
ScrollViewer.VerticalScrollBarVisibility="Auto"
VirtualizingPanel.IsVirtualizing="True"
VirtualizingPanel.VirtualizationMode="Recycling"
Loaded="TaskGrid_Loaded">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="批次" Binding="{Binding Name}" Width="160"/>
                  <DataGridTextColumn Header="任务" Binding="{Binding Task}" Width="160"/>
                  <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/>
                  <DataGridTextColumn Header="参数" Binding="{Binding Info}" Width="520"/>
                  <DataGridTextColumn Header="耗时(s)" Binding="{Binding Cost}" Width="80"/>
                  <DataGridTextColumn Header="完成时间" Binding="{Binding DoneAt}" Width="150"/>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource SplitterBg}" ShowsPreview="True"/>
            <Border Grid.Row="2" Background="{DynamicResource LogBg}" BorderBrush="{DynamicResource LogBorder}" BorderThickness="1" CornerRadius="8">
              <Grid>
                <Button Width="74" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,6,18,0" Padding="8,0" Panel.ZIndex="1" Click="ClearLog_Click">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Width="13" Height="13" StrokeThickness="1.7"
                          Data="M3.5 5H12.5 M6 5V3.5H10V5 M5 6.5V13H11V6.5 M7 8V11.5 M9 8V11.5"/>
                    <TextBlock Text="清空" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <TextBox x:Name="LogTextBox" Text="{Binding LogText, Mode=OneWay}" Background="{DynamicResource LogBg}" Foreground="{DynamicResource LogText}" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="220" Padding="8,8,8,8"/>
              </Grid>
            </Border>
          </Grid>

          <Border Grid.Row="5" Background="{DynamicResource StatusBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <TextBlock Margin="8,3" Text="{Binding StatusText}" Foreground="{DynamicResource TextSub}"/>
          </Border>
        </Grid>
      </Grid>
    <ui:SnackbarPresenter x:Name="SnackbarPresenter" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24,24,24,48"/>
    </Grid>
</ui:FluentWindow>
