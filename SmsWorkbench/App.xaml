<Application x:Class="SmsWorkbench.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SmsWorkbench.Localization"
             >
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Order matters and is load-bearing: Wpf.Ui supplies the base templates,
             Tokens.xaml the theme-independent spacing/radius/type scale, Colors.Light.xaml
             the colour keys every control style reads, and Controls.xaml the overrides.
             Colors.Light.xaml is swapped for Colors.Dark.xaml at runtime (same key set)
             by MainWindow.SwapColorScheme. -->
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Wpf.Ui.xaml"/>
        <ResourceDictionary Source="Themes/Tokens.xaml"/>
        <ResourceDictionary Source="Themes/Glyphs.xaml"/>
        <ResourceDictionary Source="Themes/Colors.Light.xaml"/>
        <ResourceDictionary Source="Themes/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <loc:PoolSummaryConverter x:Key="PoolSummaryConverter"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
