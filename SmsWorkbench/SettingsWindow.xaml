<Window x:Class="SmsWorkbench.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmsWorkbench"
        Title="设置"
        Width="1100"
        Height="780"
        MinWidth="920"
        MinHeight="660"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">
  <Window.Resources>
    <DataTemplate x:Key="TextFieldTemplate">
      <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MinHeight="34"/>
    </DataTemplate>
    <DataTemplate x:Key="SecretFieldTemplate">
      <PasswordBox local:PasswordBoxBinding.BoundPassword="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" Padding="8,5"/>
    </DataTemplate>
    <DataTemplate x:Key="BooleanFieldTemplate">
      <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay}" VerticalAlignment="Center"/>
    </DataTemplate>
    <DataTemplate x:Key="OptionsFieldTemplate">
      <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value, Mode=TwoWay}" MinHeight="34"/>
    </DataTemplate>
    <DataTemplate x:Key="MultilineFieldTemplate">
      <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               FontFamily="Consolas"
               MinHeight="124"/>
    </DataTemplate>
    <DataTemplate x:Key="SettingFieldTemplate">
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSub}" Margin="0,8,14,0" TextWrapping="Wrap"/>
        <ContentControl Grid.Column="1" Content="{Binding}">
          <ContentControl.Style>
            <Style TargetType="ContentControl">
              <Setter Property="ContentTemplate" Value="{StaticResource TextFieldTemplate}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Secret">
                  <Setter Property="ContentTemplate" Value="{StaticResource SecretFieldTemplate}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Boolean">
                  <Setter Property="ContentTemplate" Value="{StaticResource BooleanFieldTemplate}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Options">
                  <Setter Property="ContentTemplate" Value="{StaticResource OptionsFieldTemplate}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Multiline">
                  <Setter Property="ContentTemplate" Value="{StaticResource MultilineFieldTemplate}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ContentControl.Style>
        </ContentControl>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="设置分类" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="4,0,0,12"/>
          <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Title}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="22">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding SelectedCategory.Sections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,18">
                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,12"/>
                  <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource SettingFieldTemplate}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Grid>

    <Grid Grid.Row="1" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="打开配置文件" Command="{Binding OpenConfigCommand}" MinWidth="120" Margin="0,0,8,0"/>
        <Button Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="72" Margin="0,0,8,0"/>
        <Button Content="取消" IsCancel="True" MinWidth="72"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
