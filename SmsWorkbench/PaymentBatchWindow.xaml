<Window x:Class="SmsWorkbench.PaymentBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量协议支付提取"
        Width="1120"
        Height="900"
        MinWidth="920"
        MinHeight="760"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
        <TextBlock Text="批量协议支付提取" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding AccountSummary}" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center"/>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Margin="0,0,7,10">
        <TextBlock Text="支付方式" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding PaymentMethodOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedMethod}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="7,0,7,10">
        <TextBlock Text="并发" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding WorkerOptions}" SelectedItem="{Binding Workers}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="7,0,7,10">
        <TextBlock Text="瞬态重试" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding RetryOptions}" SelectedItem="{Binding Retries}"/>
      </StackPanel>
      <StackPanel Grid.Column="3" Margin="7,0,0,10">
        <TextBlock Text="Canary 数量（0=全部）" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding CanaryText, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>

      <!-- 批次默认新建；勾选断点恢复后可复用下方输入的 ID。 -->
      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,7,10">
        <TextBlock Text="Checkout 代理池（host:port:user:password；支持 http/https/socks5/socks5h）" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
        <TextBox Text="{Binding CheckoutProxyPool, UpdateSourceTrigger=PropertyChanged}"
                 FontFamily="Consolas"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 Height="62"
                 VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="{Binding CheckoutRegionSummary, StringFormat=池构成：{0}}" Foreground="{DynamicResource TextSub}" FontSize="11" Margin="0,3,0,0"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="7,0,0,10">
        <TextBlock Text="Approve / Update 代理池（host:port:user:password；支持 http/https/socks5/socks5h）" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
        <TextBox Text="{Binding ApproveProxyPool, UpdateSourceTrigger=PropertyChanged}"
                 FontFamily="Consolas"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 Height="62"
                 VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="{Binding ApproveRegionSummary, StringFormat=池构成：{0}}" Foreground="{DynamicResource TextSub}" FontSize="11" Margin="0,3,0,0"/>
      </StackPanel>

      <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,7,10">
        <TextBlock Text="Checkout 出口国家（默认跟随账单区）" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding CheckoutCountryOptions}"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="Code"
                  SelectedValue="{Binding CheckoutProxyCountry, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="7,0,0,10">
        <TextBlock Text="Approve / Update 出口国家" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding ApproveCountryOptions}"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="Code"
                  SelectedValue="{Binding ApproveProxyCountry, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>

      <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,2">
        <CheckBox Content="401 自动恢复（RT/Cookie/邮箱OTP/OAuth）" IsChecked="{Binding JitRefresh}" Margin="0,0,22,0"/>
        <CheckBox Content="仅能力探测（Checkout + Stripe init）" IsChecked="{Binding ProbeOnly}" Margin="0,0,22,0"/>
        <CheckBox Content="要求 0 元金额" IsChecked="{Binding RequireZero}" IsEnabled="{Binding RequireZeroEnabled}"/>
        <CheckBox Content="恢复已有断点" IsChecked="{Binding ResumeCheckpoint}" Margin="22,0,0,0"/>
        <TextBlock Text="{Binding ExecutionModeSummary}" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center" Margin="10,0,0,0"/>
      </StackPanel>

      <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Margin="0,0,0,10">
        <TextBlock Text="未选择邮箱时，可输入 Access Token（每行一个，最多 10 个）" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding ManualAccessTokens, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 Height="72"
                 FontFamily="Consolas"
                 VerticalScrollBarVisibility="Auto"
                 ToolTip="每行一个 JWT Access Token；选择了邮箱时此项不会参与任务"/>
      </StackPanel>
      <StackPanel Grid.Row="5" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,0,0,10">
        <TextBlock Text="批次 ID" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox Text="{Binding BatchId, UpdateSourceTrigger=PropertyChanged}" Width="300" FontFamily="Consolas"/>
        <TextBlock Text="仅勾选“恢复已有断点”时复用此 ID" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>
    </Grid>

    <!-- 账号地区 / 支付资格矩阵已移除：所有账号统一使用上方设置的代理地区。 -->

    <Grid Grid.Row="2" Margin="0,0,0,12">
        <DataGrid x:Name="ResultsGrid"
                ItemsSource="{Binding Results}"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                RowHeight="42"
                Margin="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="账号" Binding="{Binding AccountRef}" Width="135"/>
          <DataGridTextColumn Header="结果" Binding="{Binding ResultStatus}" Width="72"/>
          <DataGridTextColumn Header="进度" Binding="{Binding ProgressText}" Width="64"/>
          <DataGridTextColumn Header="阶段" Binding="{Binding CurrentStage}" Width="110"/>
          <DataGridTextColumn x:Name="AuthorizationQueueColumn" Header="BA授权队列" Binding="{Binding AuthorizationDisplay}" Width="92"/>
          <DataGridTemplateColumn Header="阶段进度" Width="125">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="12" Margin="6,0" VerticalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="支付链接 / 二维码" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Grid Margin="6,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ResultKind}"
                             Foreground="{DynamicResource TextSub}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                  <TextBlock Grid.Column="1"
                             Text="{Binding ResultDisplay}"
                             ToolTip="{Binding ResultDisplay}"
                             FontFamily="Consolas"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"/>
                  <Button Grid.Column="2"
                          Width="30"
                          Height="28"
                          Padding="0"
                          Margin="8,0,0,0"
                          Command="{Binding DataContext.CopyResultCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding HasCopyableResult}"
                          ToolTip="{Binding CopyToolTip}">
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                  </Button>
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="重试次数" Binding="{Binding Attempts}" Width="72"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="测试代理" Command="{Binding TestProxiesCommand}" MinWidth="84" Margin="0,0,8,0"/>
        <Button Content="保存代理配置" Command="{Binding SaveProxyConfigurationCommand}" MinWidth="108" Margin="0,0,8,0"/>
        <Button Content="打开报告" Command="{Binding OpenReportCommand}" MinWidth="84" Margin="0,0,8,0"/>
        <Button Content="取消" Command="{Binding RunCancelCommand}" MinWidth="72" Margin="0,0,8,0"/>
        <Button Content="开始执行" Command="{Binding RunCommand}" MinWidth="96" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
        <Button Content="关闭" MinWidth="72" IsCancel="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
