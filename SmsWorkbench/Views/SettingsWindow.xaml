<ui:FluentWindow x:Class="SmsWorkbench.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:SmsWorkbench.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:SmsWorkbench.Views"
        Title="{loc:Tr Key='设置'}"
        Width="1100"
        Height="780"
        MinWidth="920"
        MinHeight="660"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Chrome}"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="{StaticResource Type.Body.Size}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
  <Window.Resources>
    <Style x:Key="SettingsScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollViewer}">
            <Grid SnapsToDevicePixels="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                      Grid.Row="0"
                                      Grid.Column="0"
                                      Margin="{TemplateBinding Padding}"
                                      CanContentScroll="{TemplateBinding CanContentScroll}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
              <!-- No local Width/Height: StableScrollBarStyle owns the size
                   (Size.ScrollBar.Track), and a local value would beat the style —
                   which is exactly how this dialog ended up with a 10px track while
                   every other surface used the token. -->
              <ScrollBar x:Name="PART_VerticalScrollBar"
                         Grid.Row="0"
                         Grid.Column="1"
                         Maximum="{TemplateBinding ScrollableHeight}"
                         ViewportSize="{TemplateBinding ViewportHeight}"
                         Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                         Orientation="Vertical"
                         Style="{StaticResource StableScrollBarStyle}"/>
              <ScrollBar x:Name="PART_HorizontalScrollBar"
                         Grid.Row="1"
                         Grid.Column="0"
                         Maximum="{TemplateBinding ScrollableWidth}"
                         ViewportSize="{TemplateBinding ViewportWidth}"
                         Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                         Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                         Orientation="Horizontal"
                         Style="{StaticResource StableScrollBarStyle}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingsTextEditorStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SettingsMultilineEditorStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource SettingsTextEditorStyle}">
      <Setter Property="Height" Value="148"/>
      <Setter Property="MinHeight" Value="148"/>
      <Setter Property="Padding" Value="10,8,4,8"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="SettingsSecretEditorStyle"
           TargetType="PasswordBox"
           BasedOn="{StaticResource {x:Type PasswordBox}}">
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SettingsOptionsEditorStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <DataTemplate x:Key="TextFieldTemplate">
      <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
               local:MotionBehaviors.Placeholder="{Binding Label}"
               Style="{StaticResource SettingsTextEditorStyle}"/>
    </DataTemplate>
    <DataTemplate x:Key="SecretFieldTemplate">
      <PasswordBox local:PasswordBoxBinding.BoundPassword="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource SettingsSecretEditorStyle}"/>
    </DataTemplate>
    <DataTemplate x:Key="BooleanFieldTemplate">
      <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay}" VerticalAlignment="Center"/>
    </DataTemplate>
    <DataTemplate x:Key="OptionsFieldTemplate">
      <ComboBox ItemsSource="{Binding Options}"
                SelectedItem="{Binding Value, Mode=TwoWay}"
                Style="{StaticResource SettingsOptionsEditorStyle}"/>
    </DataTemplate>
    <DataTemplate x:Key="MultilineFieldTemplate">
      <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               FontFamily="{StaticResource Font.Mono}"
               FontSize="{StaticResource Type.Mono.Size}"
               Style="{StaticResource SettingsMultilineEditorStyle}">
        <TextBox.Resources>
          <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource SettingsScrollViewerStyle}"/>
        </TextBox.Resources>
      </TextBox>
    </DataTemplate>
    <DataTemplate x:Key="SettingFieldTemplate">
      <Grid Margin="0,0,0,12" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="196"/>
          <ColumnDefinition Width="*" MinWidth="0"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
              <Setter Property="Margin" Value="0,0,16,0"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Multiline">
                  <Setter Property="Margin" Value="0,8,16,0"/>
                  <Setter Property="VerticalAlignment" Value="Top"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ContentControl Grid.Column="1" Content="{Binding}">
          <ContentControl.Style>
            <Style TargetType="ContentControl">
              <Setter Property="HorizontalAlignment" Value="Stretch"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="VerticalContentAlignment" Value="Stretch"/>
              <Setter Property="ContentTemplate" Value="{StaticResource TextFieldTemplate}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Secret">
                  <Setter Property="ContentTemplate" Value="{StaticResource SecretFieldTemplate}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Boolean">
                  <Setter Property="ContentTemplate" Value="{StaticResource BooleanFieldTemplate}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Options">
                  <Setter Property="ContentTemplate" Value="{StaticResource OptionsFieldTemplate}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Multiline">
                  <Setter Property="ContentTemplate" Value="{StaticResource MultilineFieldTemplate}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ContentControl.Style>
        </ContentControl>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid Background="{DynamicResource Surface.Chrome}">
    <Grid.RowDefinitions>
      <RowDefinition Height="38"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <local:SecondaryTitleBar Grid.Row="0" TitleText="{loc:Tr Key='设置'}"/>

    <Border Grid.Row="1"
            Margin="8,0,8,8"
            CornerRadius="{DynamicResource Corner.Xl}"
            Background="{DynamicResource Surface.Page}"
            BorderBrush="{DynamicResource WorkspaceFrameOutline}"
            BorderThickness="1"
            ClipToBounds="True">
      <Grid Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!-- Category rail -->
          <Border Background="{DynamicResource Surface.Block}"
                  BorderBrush="{DynamicResource Divider}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Corner.Lg}"
                  Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Key='设置分类'}" FontSize="{StaticResource Type.Body.Size}" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="4,0,0,12"/>
          <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Title}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Margin" Value="0,0,0,3"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Grid>
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Corner.Md}"
                                Padding="{TemplateBinding Padding}">
                          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <Border x:Name="SelectedIndicator"
                                Width="3"
                                Margin="0,7"
                                HorizontalAlignment="Left"
                                CornerRadius="{StaticResource Corner.Hairline}"
                                Background="{DynamicResource AccentIndicator}"
                                Visibility="Collapsed"/>
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource PanelHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SettingsSelectionBg}"/>
                          <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource SettingsSelectionBorder}"/>
                          <Setter TargetName="ItemChrome" Property="BorderThickness" Value="1"/>
                          <Setter TargetName="SelectedIndicator" Property="Visibility" Value="Visible"/>
                          <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                          <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="2"
              Background="{DynamicResource Surface.Card}"
              BorderBrush="{DynamicResource Divider}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Corner.Lg}"
              Padding="22,18,22,18">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0"
                     Text="{Binding SelectedCategory.Title}"
                     FontSize="{StaticResource Type.Title.Size}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextMain}"
                     Margin="0,0,0,10"/>
          <ScrollViewer x:Name="SettingsContentScrollViewer"
                        Grid.Row="1"
                        Style="{StaticResource SettingsScrollViewerStyle}"
                        Padding="0,0,12,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SelectedCategory.Sections}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource Type.Subtitle.Size}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Fields}"
                                  ItemTemplate="{StaticResource SettingFieldTemplate}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="1"
            BorderBrush="{DynamicResource Divider}"
            BorderThickness="0,1,0,0"
            Margin="0,12,0,0"
            Padding="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="{loc:Tr Key='打开配置文件'}" Command="{Binding OpenConfigCommand}" MinWidth="120" Margin="0,0,8,0"/>
          <Button Content="{loc:Tr Key='取消'}" IsCancel="True" MinWidth="72" Margin="0,0,8,0"/>
          <Button Content="{loc:Tr Key='保存'}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="72"/>
        </StackPanel>
      </Grid>
    </Border>
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
