<UserControl x:Class="SmsWorkbench.AccountGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SmsWorkbench.Localization"
             xmlns:local="clr-namespace:SmsWorkbench">
  <!-- Account table + its context menu. The converters and menu styles live in
       this control's dictionary because the templates that use them do; a
       window-level StaticResource would not be visible while this XAML parses. -->
  <UserControl.Resources>
    <local:StatusSeverityConverter x:Key="StatusSeverityConverter"/>
    <local:PaymentQualificationSeverityConverter x:Key="QualificationSeverity"/>
    <!-- The stock DataGrid ScrollViewer template fills the square between the
         two scroll bars with SystemColors.ControlBrushKey — an opaque light grey
         that ignores the palette. In a small window the horizontal bar appears and
         that patch lands right where the vertical bar ends, so the slider looked
         cut off at the bottom. Transparent lets the card surface show through;
         the bars themselves keep their themed style. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
    <local:NarrowWidthConverter x:Key="NarrowWidth"/>
    <local:RtDisplayConverter x:Key="RtDisplayConverter"/>
    <Style x:Key="AccountContextMenuStyle" TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="5"/>
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="{StaticResource Type.Data.Size}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border x:Name="MenuChrome"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Corner.Md}"
                    SnapsToDevicePixels="True">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccountContextMenuItemStyle" TargetType="MenuItem">
      <Setter Property="MinWidth" Value="232"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="{StaticResource Type.Data.Size}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="ItemChrome"
                    Height="{TemplateBinding Height}"
                    Background="Transparent"
                    Padding="8,0,12,0"
                    SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="IconPresenter"
                                  Grid.Column="0"
                                  ContentSource="Icon"
                                  Width="16" Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  SnapsToDevicePixels="True"/>
                <TextBlock x:Name="HeaderText"
                           Grid.Column="2"
                           Text="{TemplateBinding Header}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           Foreground="{TemplateBinding Foreground}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           SnapsToDevicePixels="True"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource PanelHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemChrome" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
          <!-- The table is a card on the page: fill, no stroke. -->
          <Border Margin="0,0,0,8" Padding="0" CornerRadius="{StaticResource Corner.Xl}" Background="{DynamicResource Surface.Card}" BorderThickness="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <!-- Density switch. The B-tier columns are hidden, not removed, so
                   sorting, the ViewModel and the context menu stay untouched. -->
              <Grid Grid.Row="0" Margin="12,8,12,2">
                <CheckBox x:Name="CompactColumnsToggle"
                          Content="{loc:Tr Key='精简列：隐藏时间 / 注册区 / 优惠 / 支付资格'}"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextSub}"
                          Checked="CompactColumnsToggle_Changed"
                          Unchecked="CompactColumnsToggle_Changed"/>
              </Grid>

            <DataGrid x:Name="AccountGrid"
                      Grid.Row="1"
                      ItemsSource="{Binding Pool.PagedRows}"
                      SelectedItem="{Binding Pool.SelectedRow}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      EnableColumnVirtualization="True"
                      Sorting="AccountGrid_Sorting"
                      SelectionChanged="AccountGrid_SelectionChanged">
              <DataGrid.Style>
                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=local:AccountGridView}, Converter={StaticResource NarrowWidth}}"
                                 Value="True">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.Style>
              <DataGrid.ContextMenu>
                <ContextMenu Style="{StaticResource AccountContextMenuStyle}">
                  <MenuItem Header="{loc:Tr Key='查看账号详情'}" Command="{Binding PlacementTarget.DataContext.CtxViewDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Style="{StaticResource MenuIconPath}"
                            Data="{StaticResource Glyph.View}"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="{loc:Tr Key='查看邮箱收件箱'}" Command="{Binding PlacementTarget.DataContext.CtxViewInboxCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Style="{StaticResource MenuIconPath}"
                            Data="{StaticResource Glyph.ImportMail}"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Header="{loc:Tr Key='复制邮箱地址'}" Command="{Binding PlacementTarget.DataContext.CtxCopyEmailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Style="{StaticResource MenuIconPath}"
                            Data="{StaticResource Glyph.PayLink}"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="{loc:Tr Key='复制 AT'}" Command="{Binding PlacementTarget.DataContext.CtxCopyAccessTokenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Style="{StaticResource MenuIconPath}"
                            Data="{StaticResource Glyph.Key}"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="{loc:Tr Key='复制支付链接'}" Command="{Binding PlacementTarget.DataContext.CtxCopyPayPalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Style="{StaticResource MenuIconPath}"
                            Data="{StaticResource Glyph.PayLink}"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="{loc:Tr Key='打开支付链接'}" Command="{Binding PlacementTarget.DataContext.CtxOpenPayPalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Style="{StaticResource MenuIconPath}"
                            Data="{StaticResource Glyph.OpenExternal}"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="{loc:Tr Key='批量协议支付'}" Command="{Binding PlacementTarget.DataContext.CtxBatchProtocolPaymentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Style="{StaticResource MenuIconPath}"
                            Data="{StaticResource Glyph.BatchPay}"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="{loc:Tr Key='批量邮箱换绑'}" Command="{Binding PlacementTarget.DataContext.CtxChangeEmailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" Fill="Transparent" Data="{StaticResource Glyph.ChangeEmail}"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Header="{loc:Tr Key='测活当前账号'}" Command="{Binding PlacementTarget.DataContext.CtxCheckAccountAliveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Style="{StaticResource MenuIconPath}"
                            Data="{StaticResource Glyph.ProbeAlive}"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Header="{loc:Tr Key='打开 Session 源文件'}" Command="{Binding PlacementTarget.DataContext.CtxOpenSourceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Style="{StaticResource MenuIconPath}"
                            Data="{StaticResource Glyph.Folder}"/>
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="{loc:Tr Key='选中'}" Binding="{Binding IsChecked}" Width="60"/>
                <DataGridTextColumn Header="{loc:Tr Key='创建时间'}" Binding="{Binding CreatedAt}" Width="155" IsReadOnly="True"/>
                <DataGridTextColumn Header="{loc:Tr Key='更新时间'}" Binding="{Binding CompletedAt}" Width="155" IsReadOnly="True"/>
                <DataGridTextColumn Header="{loc:Tr Key='邮箱'}" Binding="{Binding Identifier}" Width="260" IsReadOnly="True"/>
                <DataGridTextColumn Header="{loc:Tr Key='账号类型'}" Binding="{Binding AccountPlanType}" Width="92" IsReadOnly="True"/>
                <DataGridTextColumn Header="{loc:Tr Key='注册区'}" Binding="{Binding RegistrationCountry}" Width="64" IsReadOnly="True"/>
                <DataGridTextColumn Header="{loc:Tr Key='类型'}" Binding="{Binding AccountType}" Width="120" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="{loc:Tr Key='状态'}" Width="96" IsReadOnly="True" SortMemberPath="Status" CanUserSort="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusBadge}" Tag="{Binding Status, Converter={StaticResource StatusSeverityConverter}}">
                        <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="AT" Width="96" IsReadOnly="True" SortMemberPath="AccessTokenStatus" CanUserSort="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusBadge}" Tag="{Binding AccessTokenStatus, Converter={StaticResource StatusSeverityConverter}}">
                        <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding AccessTokenStatus}" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="RT" Width="96" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusBadge}" Tag="{Binding RefreshTokenStatus, Converter={StaticResource StatusSeverityConverter}}">
                        <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding RefreshTokenStatus, Converter={StaticResource RtDisplayConverter}}" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="2FA" Width="96" IsReadOnly="True" SortMemberPath="TwoFactorStatus" CanUserSort="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusBadge}" Tag="{Binding TwoFactorStatus, Converter={StaticResource StatusSeverityConverter}}">
                        <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding TwoFactorStatus}" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{loc:Tr Key='优惠状态'}" Width="150" IsReadOnly="True" SortMemberPath="PromotionStatus" CanUserSort="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusBadge}" Tag="{Binding PromotionStatus, Converter={StaticResource StatusSeverityConverter}}" ToolTip="{Binding PromotionStatus}">
                        <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding PromotionStatus}" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{loc:Tr Key='支付资格'}" Width="140" IsReadOnly="True" SortMemberPath="PaymentQualification" CanUserSort="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <!-- Severity from the machine state, with the composed label as
                           the fallback for rows written before the state existed. -->
                      <Border Style="{StaticResource StatusBadge}" ToolTip="{Binding PaymentQualification}">
                        <Border.Tag>
                          <MultiBinding Converter="{StaticResource QualificationSeverity}">
                            <Binding Path="PaymentQualificationState"/>
                            <Binding Path="PaymentQualification"/>
                          </MultiBinding>
                        </Border.Tag>
                        <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding PaymentQualification}" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{loc:Tr Key='详情'}" Width="80">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Height="24" Padding="6,0" Command="{Binding DataContext.AccountDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="{loc:Tr Key='查看详情'}">
                        <StackPanel Orientation="Horizontal">
                          <Path Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                Data="{StaticResource Glyph.View}"/>
                          <TextBlock Text="{loc:Tr Key='查看'}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource Type.Caption.Size}"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>

              <!-- Narrow window: the same rows as a two-line card list. Both views bind
                   Pool.PagedRows and Pool.SelectedRow, so selection and the tick-box
                   behave identically; only the presentation switches. -->
              <ListBox x:Name="AccountCardList"
                       Grid.Row="1"
                       Margin="8,0,8,8"
                       ItemsSource="{Binding Pool.PagedRows}"
                       SelectedItem="{Binding Pool.SelectedRow, Mode=TwoWay}"
                       SelectionChanged="AccountGrid_SelectionChanged"
                       Background="Transparent"
                       BorderThickness="0"
                       Visibility="Collapsed"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.Style>
                  <Style TargetType="ListBox">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=local:AccountGridView}, Converter={StaticResource NarrowWidth}}"
                                   Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="CardChrome" Background="Transparent" CornerRadius="{StaticResource Corner.Xl}">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="CardChrome" Property="Background" Value="{DynamicResource Surface.Block}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="CardChrome" Property="Background" Value="{DynamicResource Surface.Block}"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Surface.Card}" CornerRadius="{StaticResource Corner.Xl}" Padding="12,10">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                          <TextBlock Grid.Column="1" Text="{Binding Identifier}" Style="{StaticResource Text.Subtitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                          <Border Grid.Column="2" Style="{StaticResource StatusBadge}" Tag="{Binding Status, Converter={StaticResource StatusSeverityConverter}}">
                            <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
                          </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="26,6,0,0">
                          <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding AccountPlanType}"/>
                          <TextBlock Style="{StaticResource Text.Caption}" Margin="10,0,0,0" Text="{Binding AccessTokenStatus, StringFormat='AT {0}'}"/>
                          <TextBlock Style="{StaticResource Text.Caption}" Margin="8,0,0,0" Text="{Binding RefreshTokenStatus, StringFormat='RT {0}'}"/>
                          <TextBlock Style="{StaticResource Text.Caption}" Margin="8,0,0,0" Text="{Binding TwoFactorStatus, StringFormat='2FA {0}'}"/>
                          <TextBlock Style="{StaticResource Text.Caption}" Margin="8,0,0,0" Text="{Binding PromotionStatus, StringFormat='优惠 {0}'}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

            </Grid>
          </Border>
</UserControl>
