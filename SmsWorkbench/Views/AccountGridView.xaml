<UserControl x:Class="SmsWorkbench.Views.AccountGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SmsWorkbench.Localization"
             xmlns:local="clr-namespace:SmsWorkbench.Views">
  <!-- Account table + its context menu. Context menu uses concentric radii
       (Corner.Lg=10 shell, Padding=4, Corner.Sm=6 items) and unified MenuIconPath
       Tabler glyphs. -->
  <UserControl.Resources>
    <local:PaymentQualificationSeverityConverter x:Key="QualificationSeverity"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
    <local:NarrowWidthConverter x:Key="NarrowWidth"/>
    <local:RtDisplayConverter x:Key="RtDisplayConverter"/>
    <Style x:Key="AccountContextMenuStyle" TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource Surface.Card}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceFrameOutline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
      <Setter Property="FontSize" Value="{StaticResource Type.Data.Size}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
      <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border x:Name="MenuChrome"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Corner.Lg}"
                    SnapsToDevicePixels="True">
              <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="16" ShadowDepth="3" Direction="270"/>
              </Border.Effect>
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccountContextMenuItemStyle" TargetType="MenuItem">
      <Setter Property="MinWidth" Value="224"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
      <Setter Property="FontSize" Value="{StaticResource Type.Data.Size}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
      <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="ItemChrome"
                    Height="{TemplateBinding Height}"
                    Background="Transparent"
                    CornerRadius="{StaticResource Corner.Sm}"
                    Padding="8,0,12,0"
                    SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="IconPresenter"
                                  Grid.Column="0"
                                  ContentSource="Icon"
                                  Width="16" Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  SnapsToDevicePixels="True"/>
                <TextBlock x:Name="HeaderText"
                           Grid.Column="2"
                           Text="{TemplateBinding Header}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           Foreground="{TemplateBinding Foreground}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           SnapsToDevicePixels="True"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource PanelHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemChrome" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border Margin="0,0,0,4" Padding="0" CornerRadius="{StaticResource Corner.Xl}" Background="{DynamicResource Surface.Card}" BorderThickness="0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Slim column density strip -->
      <Grid Grid.Row="0" Margin="12,5,12,2">
        <CheckBox x:Name="CompactColumnsToggle"
                  Content="{loc:Tr Key='精简列：隐藏时间 / 注册区 / 支付资格'}"
                  FontSize="{StaticResource Type.Caption.Size}"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource TextSub}"
                  Checked="CompactColumnsToggle_Changed"
                  Unchecked="CompactColumnsToggle_Changed"/>
      </Grid>

      <DataGrid x:Name="AccountGrid"
                Grid.Row="1"
                ItemsSource="{Binding Pool.PagedRows}"
                SelectedItem="{Binding Pool.SelectedRow}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                VirtualizingPanel.ScrollUnit="Pixel"
                EnableColumnVirtualization="True"
                Sorting="AccountGrid_Sorting"
                SelectionChanged="AccountGrid_SelectionChanged">
        <DataGrid.Style>
          <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=local:AccountGridView}, Converter={StaticResource NarrowWidth}}"
                           Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.Style>
        <DataGrid.ContextMenu>
          <ContextMenu Style="{StaticResource AccountContextMenuStyle}">
            <MenuItem Header="{loc:Tr Key='查看账号详情'}" Command="{Binding PlacementTarget.DataContext.CtxViewDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
              <MenuItem.Icon>
                <Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Glyph.View}"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Tr Key='查看邮箱收件箱'}" Command="{Binding PlacementTarget.DataContext.CtxViewInboxCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
              <MenuItem.Icon>
                <Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Glyph.Inbox}"/>
              </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{loc:Tr Key='复制邮箱地址'}" Command="{Binding PlacementTarget.DataContext.CtxCopyEmailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
              <MenuItem.Icon>
                <Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Glyph.Copy}"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Tr Key='复制 AT'}" Command="{Binding PlacementTarget.DataContext.CtxCopyAccessTokenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
              <MenuItem.Icon>
                <Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Glyph.Key}"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Tr Key='复制支付链接'}" Command="{Binding PlacementTarget.DataContext.CtxCopyPayPalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
              <MenuItem.Icon>
                <Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Glyph.PayLink}"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Tr Key='打开支付链接'}" Command="{Binding PlacementTarget.DataContext.CtxOpenPayPalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
              <MenuItem.Icon>
                <Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Glyph.OpenExternal}"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Tr Key='支付链接提取'}" Command="{Binding PlacementTarget.DataContext.CtxBatchProtocolPaymentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
              <MenuItem.Icon>
                <Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Glyph.BatchPay}"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Tr Key='批量邮箱换绑'}" Command="{Binding PlacementTarget.DataContext.CtxChangeEmailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
              <MenuItem.Icon>
                <Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Glyph.ChangeEmail}"/>
              </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{loc:Tr Key='测活当前账号'}" Command="{Binding PlacementTarget.DataContext.CtxCheckAccountAliveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
              <MenuItem.Icon>
                <Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Glyph.ProbeAlive}"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Tr Key='轻量巡检当前账号'}" Command="{Binding PlacementTarget.DataContext.CtxInspectAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
              <MenuItem.Icon>
                <Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Glyph.Inspect}"/>
              </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{loc:Tr Key='打开 Session 源文件'}" Command="{Binding PlacementTarget.DataContext.CtxOpenSourceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource AccountContextMenuItemStyle}">
              <MenuItem.Icon>
                <Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Glyph.Folder}"/>
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="{loc:Tr Key='选中'}" Binding="{Binding IsChecked}" Width="60"/>
          <DataGridTextColumn Header="{loc:Tr Key='创建时间'}" Binding="{Binding CreatedAt}" Width="176" IsReadOnly="True"/>
          <DataGridTextColumn Header="{loc:Tr Key='更新时间'}" Binding="{Binding CompletedAt}" Width="176" IsReadOnly="True"/>
          <DataGridTextColumn Header="{loc:Tr Key='邮箱'}" Binding="{Binding Identifier}" Width="260" IsReadOnly="True"/>
          <DataGridTextColumn Header="{loc:Tr Key='账号类型'}" Binding="{Binding AccountPlanType}" Width="92" IsReadOnly="True"/>
          <DataGridTextColumn Header="{loc:Tr Key='注册区'}" Binding="{Binding RegistrationCountry}" Width="64" IsReadOnly="True"/>
          <DataGridTextColumn Header="{loc:Tr Key='类型'}" Binding="{Binding AccountType}" Width="120" IsReadOnly="True"/>
          <DataGridTemplateColumn Header="{loc:Tr Key='状态'}" Width="96" IsReadOnly="True" SortMemberPath="Status" CanUserSort="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource StatusBadge}" Tag="{Binding StatusSeverity}">
                  <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="AT" Width="96" IsReadOnly="True" SortMemberPath="AccessTokenStatus" CanUserSort="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource StatusBadge}" Tag="{Binding AccessTokenSeverity}">
                  <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding AccessTokenStatus}" TextTrimming="CharacterEllipsis"/>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="RT" Width="96" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource StatusBadge}" Tag="{Binding RefreshTokenSeverity}">
                  <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding RefreshTokenStatus, Converter={StaticResource RtDisplayConverter}}" TextTrimming="CharacterEllipsis"/>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="2FA" Width="96" IsReadOnly="True" SortMemberPath="TwoFactorStatus" CanUserSort="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource StatusBadge}" Tag="{Binding TwoFactorSeverity}">
                  <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding TwoFactorStatus}" TextTrimming="CharacterEllipsis"/>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{loc:Tr Key='优惠状态'}" Width="150" IsReadOnly="True" SortMemberPath="PromotionStatus" CanUserSort="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource StatusBadge}" Tag="{Binding PromotionSeverity}" ToolTip="{Binding PromotionStatus}">
                  <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding PromotionStatus}" TextTrimming="CharacterEllipsis"/>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{loc:Tr Key='支付资格'}" Width="140" IsReadOnly="True" SortMemberPath="PaymentQualification" CanUserSort="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource StatusBadge}" ToolTip="{Binding PaymentQualification}">
                  <Border.Tag>
                    <MultiBinding Converter="{StaticResource QualificationSeverity}">
                      <Binding Path="PaymentQualificationState"/>
                      <Binding Path="PaymentQualification"/>
                    </MultiBinding>
                  </Border.Tag>
                  <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding PaymentQualification}" TextTrimming="CharacterEllipsis"/>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{loc:Tr Key='详情'}" Width="78">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Style="{StaticResource GhostToolbarButton}"
                        Height="24"
                        Padding="6,0"
                        Command="{Binding DataContext.AccountDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}"
                        ToolTip="{loc:Tr Key='查看详情'}">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource CompactIconPath}" Data="{StaticResource Glyph.View}"/>
                    <TextBlock Text="{loc:Tr Key='查看'}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource Type.Caption.Size}"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <!-- Narrow window: two-line card list sharing the exact same bindings -->
      <ListBox x:Name="AccountCardList"
               Grid.Row="1"
               Margin="8,0,8,8"
               ItemsSource="{Binding Pool.PagedRows}"
               SelectedItem="{Binding Pool.SelectedRow, Mode=TwoWay}"
               SelectionChanged="AccountGrid_SelectionChanged"
               Background="Transparent"
               BorderThickness="0"
               Visibility="Collapsed"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.Style>
          <Style TargetType="ListBox">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=local:AccountGridView}, Converter={StaticResource NarrowWidth}}"
                           Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ListBox.Style>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="CardChrome" Background="Transparent" CornerRadius="{StaticResource Corner.Lg}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="CardChrome" Property="Background" Value="{DynamicResource Surface.Block}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="CardChrome" Property="Background" Value="{DynamicResource PrimarySoft}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource Surface.Card}" CornerRadius="{StaticResource Corner.Lg}" Padding="12,10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="1" Text="{Binding Identifier}" Style="{StaticResource Text.Subtitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <Border Grid.Column="2" Style="{StaticResource StatusBadge}" Tag="{Binding StatusSeverity}">
                    <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
                  </Border>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="26,6,0,0">
                  <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding AccountPlanType}"/>
                  <TextBlock Style="{StaticResource Text.Caption}" Margin="10,0,0,0" Text="{Binding AccessTokenStatus, StringFormat='AT {0}'}"/>
                  <TextBlock Style="{StaticResource Text.Caption}" Margin="8,0,0,0" Text="{Binding RefreshTokenStatus, StringFormat='RT {0}'}"/>
                  <TextBlock Style="{StaticResource Text.Caption}" Margin="8,0,0,0" Text="{Binding TwoFactorStatus, StringFormat='2FA {0}'}"/>
                  <TextBlock Style="{StaticResource Text.Caption}" Margin="8,0,0,0" Text="{Binding PromotionStatus, StringFormat='优惠 {0}'}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
