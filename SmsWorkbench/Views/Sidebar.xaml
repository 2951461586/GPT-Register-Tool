<UserControl x:Class="SmsWorkbench.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SmsWorkbench.Localization"
             xmlns:local="clr-namespace:SmsWorkbench">
  <!-- Sidebar visuals only: the column width (and its animation) stays on
       MainWindow because `SidebarColumn` is a definition of the window grid.
       `IsCollapsed` drives every visual trigger; `ToggleRequested` asks the
       window to flip `SidebarCollapsed`. -->
  <UserControl.Resources>
    <local:NavKeyEqualsConverter x:Key="NavKeyEqualsConverter"/>
    <local:NavCancelAlertConverter x:Key="NavCancelAlertConverter"/>
    <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
      <!-- Self-contained: this dictionary is a UserControl's, so it cannot rely
           on the application-level implicit Button style. These five setters are
           what that style contributed before the split; the Template below
           overrides the rest. -->
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="{DynamicResource SidebarButtonBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Corner.Lg}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelHover}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelHover}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconNavButtonStyle" TargetType="local:IconNavButton">
      <!--
        A row separates from the chrome by a step in lightness, not by a stroke:
        transparent at rest, Surface.Block on hover, Surface.Card plus a primary
        bar while its action runs (IsActive). The bar is the only colour the row
        ever spends, and only on real state.
      -->
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="14,0,12,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}"/>
      <Setter Property="IsActive">
        <Setter.Value>
          <MultiBinding Converter="{StaticResource NavKeyEqualsConverter}">
            <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/>
            <Binding Path="ActiveKey" RelativeSource="{RelativeSource AncestorType=local:Sidebar}"/>
          </MultiBinding>
        </Setter.Value>
      </Setter>
      <Setter Property="IsAlert">
        <Setter.Value>
          <MultiBinding Converter="{StaticResource NavCancelAlertConverter}">
            <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/>
            <Binding Path="ActiveKey" RelativeSource="{RelativeSource AncestorType=local:Sidebar}"/>
          </MultiBinding>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="local:IconNavButton">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderThickness="0"
                    CornerRadius="{StaticResource Corner.Lg}">
              <Grid>
                <Border x:Name="SelectionBar"
                        Width="3"
                        Margin="0,8"
                        HorizontalAlignment="Left"
                        CornerRadius="{StaticResource Corner.Hairline}"
                        Background="{DynamicResource Primary}"
                        Visibility="Collapsed"/>
                <Grid Margin="{TemplateBinding Padding}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Path x:Name="Glyph"
                        Grid.Column="0"
                        Width="17" Height="17"
                        Stretch="Uniform"
                        Stroke="{DynamicResource TextSub}"
                        StrokeThickness="1.4"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Fill="Transparent"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="{TemplateBinding IconGeometry}"/>
                  <TextBlock x:Name="Label"
                             Grid.Column="1"
                             Text="{TemplateBinding Text}"
                             Style="{DynamicResource SidebarLabelStyle}"
                             FontSize="{StaticResource Type.Subtitle.Size}"
                             Foreground="{DynamicResource TextMain}"
                             VerticalAlignment="Center"/>
                </Grid>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Block}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsActive" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Card}"/>
                <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Primary}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextMain}"/>
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <!-- Cancel is tinted only while something is running: colour marks
                   state, and "nothing to cancel" is not a state worth colouring. -->
              <Trigger Property="IsAlert" Value="True">
                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Danger}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Danger}"/>
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SidebarPaneBorderStyle" TargetType="Border">
      <!-- The chrome is its own surface; the divider against the content is drawn
           once by MainWindow, so the pane adds no second edge. -->
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource Corner.Xl}"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style x:Key="SidebarBrandLogoStyle" TargetType="Border">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="{DynamicResource SidebarBg}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarBrandTextPanelStyle" TargetType="StackPanel">
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="{StaticResource Corner.Md}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
          <Setter Property="Margin" Value="0,0,9,0"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarScrollBarStyle" TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarSectionHeaderStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="13"/>
      <Setter Property="Margin" Value="4,12,0,5"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextAlignment" Value="Left"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
          <Setter Property="Margin" Value="4,12,4,5"/>
          <Setter Property="HorizontalAlignment" Value="Stretch"/>
          <Setter Property="TextAlignment" Value="Left"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
        <Grid Margin="10,0,10,10" ClipToBounds="True" HorizontalAlignment="Stretch">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Height="58"
                  Margin="0,0,0,10"
                  Style="{StaticResource SidebarPaneBorderStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource SidebarBrandLogoStyle}">
                <!-- The PNG (1024x1024) instead of app-icon.ico: an ICO's frame
                     choice is unrelated to the 22px being drawn, and the default
                     bilinear downscale of a 46x reduction is why this mark looked
                     soft. HighQuality (Fant) plus an even 24px inside the 40px tile
                     keeps the strokes crisp. -->
                <Image Source="/Assets/black-kitten.png"
                       Width="24" Height="24"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Style="{StaticResource SidebarBrandTextPanelStyle}" Margin="10,0,8,0">
                <TextBlock x:Name="SidebarBrandTitle"
                           Text="GPT Register Tool"
                           FontSize="{StaticResource Type.Body.Size}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button x:Name="SidebarToggleButton" Grid.Column="2" Click="Toggle_Click">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource SidebarToggleButtonStyle}">
                    <Setter Property="ToolTip" Value="{loc:Tr Key='收起侧边栏'}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}}" Value="True">
                        <Setter Property="ToolTip" Value="{loc:Tr Key='展开侧边栏'}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Path Width="16" Height="16" Stretch="Uniform"
                      Stroke="{DynamicResource TextSub}" StrokeThickness="1.25"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path.Style>
                    <Style TargetType="Path">
                      <Setter Property="Data" Value="M5 4H19A1 1 0 0 1 20 5V19A1 1 0 0 1 19 20H5A1 1 0 0 1 4 19V5A1 1 0 0 1 5 4Z M10 4V20"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}}" Value="True">
                          <Setter Property="Data" Value="M5 4H19A1 1 0 0 1 20 5V19A1 1 0 0 1 19 20H5A1 1 0 0 1 4 19V5A1 1 0 0 1 5 4Z M14 4V20"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Path.Style>
                </Path>
              </Button>
            </Grid>
          </Border>

          <Border Grid.Row="1"
                  Style="{StaticResource SidebarPaneBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
              <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SidebarScrollBarStyle}"/>
              </ScrollViewer.Resources>
              <StackPanel>
                <TextBlock Text="{loc:Tr Key='一键操作'}" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Register}" Text="{loc:Tr Key='一键注册'}" Command="{Binding NavCommand}" CommandParameter="register"/>
                <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Sms}" Text="{loc:Tr Key='一键接码'}" Command="{Binding NavCommand}" CommandParameter="sms"/>
                <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Scan}" Text="{loc:Tr Key='账号测活'}" Command="{Binding NavCommand}" CommandParameter="scan"/>
                <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Promotion}" Text="{loc:Tr Key='查优惠'}" Command="{Binding NavCommand}" CommandParameter="promotion"/>
                <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.PaymentQualification}" Text="{loc:Tr Key='查支付资格'}" Command="{Binding NavCommand}" CommandParameter="paymentqualification"/>

                <TextBlock Text="{loc:Tr Key='支付管理'}" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.PayLink}" Text="{loc:Tr Key='打开支付链接'}" Command="{Binding NavCommand}" CommandParameter="paylink"/>
                <local:IconNavButton AutomationProperties.Name="{loc:Tr Key='批量协议支付'}" Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.BatchPay}" Text="{loc:Tr Key='批量协议支付'}" Command="{Binding NavCommand}" CommandParameter="batchpay"/>
                <TextBlock Text="{loc:Tr Key='邮箱管理'}" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.ImportMail}" Text="{loc:Tr Key='导入邮箱'}" Command="{Binding NavCommand}" CommandParameter="importmail"/>
                <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Inbox}" Text="{loc:Tr Key='查看收件箱'}" Command="{Binding NavCommand}" CommandParameter="inbox"/>
                <local:IconNavButton AutomationProperties.Name="{loc:Tr Key='邮箱换绑'}" Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.ChangeEmail}" Text="{loc:Tr Key='邮箱换绑'}" Command="{Binding NavCommand}" CommandParameter="changeemail"/>

                <TextBlock Text="{loc:Tr Key='账号管理'}" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.ImportCpa}" Text="{loc:Tr Key='一键导入'}" Command="{Binding NavCommand}" CommandParameter="importcpa"/>
                <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Export}" Text="{loc:Tr Key='导出账号'}" Command="{Binding NavCommand}" CommandParameter="export"/>
                <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Delete}" Text="{loc:Tr Key='删除选中'}" Command="{Binding NavCommand}" CommandParameter="delete"/>

                <TextBlock Text="{loc:Tr Key='项目设置'}" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.ProxyPool}" Text="{loc:Tr Key='代理池管理'}" Command="{Binding NavCommand}" CommandParameter="proxypool"/>
                <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Refresh}" Text="{loc:Tr Key='刷新'}" Command="{Binding NavCommand}" CommandParameter="refresh"/>
                <local:IconNavButton AutomationProperties.Name="{loc:Tr Key='设置'}" Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Settings}" Text="{loc:Tr Key='设置'}" Command="{Binding NavCommand}" CommandParameter="settings"/>
                <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{Binding ThemeIconGeometry}" Text="{loc:Tr Key='切换主题'}" Command="{Binding NavCommand}" CommandParameter="theme"/>
                <local:IconNavButton AutomationProperties.Name="{loc:Tr Key='切换语言'}" Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Language}" Text="{loc:Tr Key='切换EN/CN'}" ToolTip="{loc:Tr Key='切换语言'}" Command="{Binding NavCommand}" CommandParameter="language"/>
                <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.CancelBatch}" Text="{loc:Tr Key='取消批次'}" Command="{Binding NavCommand}" CommandParameter="cancelbatch"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
</UserControl>
