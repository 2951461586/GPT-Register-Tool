<UserControl x:Class="SmsWorkbench.Views.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SmsWorkbench.Localization"
             xmlns:local="clr-namespace:SmsWorkbench.Views">
  <!-- Full-height chrome sidebar (DeepAI Code layout):
       Row 0: 38px brand header aligned with the right title bar.
       Row 1: Scrollable core workflow actions (compact 34px rows, recessed IconMuted glyphs).
       Row 2: Sticky utility footer (dynamic Cancel Batch alert + Settings + Shell/Theme/Language dock). -->
  <UserControl.Resources>
    <local:NavKeyEqualsConverter x:Key="NavKeyEqualsConverter"/>
    <local:NavCancelAlertConverter x:Key="NavCancelAlertConverter"/>

    <!-- Preserved for backward resource compatibility (checked by DesktopWindowSmokeTests) -->
    <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="{DynamicResource SidebarButtonBg}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Corner.Md}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SidebarHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SidebarPressed}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="IconNavButtonStyle" TargetType="local:IconNavButton">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="10,0,10,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}"/>
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      <Setter Property="IsActive">
        <Setter.Value>
          <MultiBinding Converter="{StaticResource NavKeyEqualsConverter}">
            <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/>
            <Binding Path="ActiveKey" RelativeSource="{RelativeSource AncestorType=local:Sidebar}"/>
          </MultiBinding>
        </Setter.Value>
      </Setter>
      <Setter Property="IsAlert">
        <Setter.Value>
          <MultiBinding Converter="{StaticResource NavCancelAlertConverter}">
            <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/>
            <Binding Path="ActiveKey" RelativeSource="{RelativeSource AncestorType=local:Sidebar}"/>
          </MultiBinding>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="local:IconNavButton">
            <Grid x:Name="RowRoot" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
              </Grid.RenderTransform>
              <Border x:Name="Chrome"
                      Background="{TemplateBinding Background}"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      CornerRadius="{StaticResource Corner.Md}"/>
              <Border x:Name="HoverFill"
                      Background="{DynamicResource SidebarHover}"
                      CornerRadius="{StaticResource Corner.Md}"
                      Opacity="0"
                      IsHitTestVisible="False"/>
              <Border x:Name="PressedFill"
                      Background="{DynamicResource SidebarPressed}"
                      CornerRadius="{StaticResource Corner.Md}"
                      Opacity="0"
                      IsHitTestVisible="False"/>
              <Grid>
                <Border x:Name="SelectionBar"
                        Width="3"
                        Margin="0,7"
                        HorizontalAlignment="Left"
                        CornerRadius="{StaticResource Corner.Hairline}"
                        Background="{DynamicResource AccentIndicator}"
                        Visibility="Collapsed"/>
                <Grid x:Name="ContentGrid" Margin="{TemplateBinding Padding}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Path x:Name="Glyph"
                        Grid.Column="0"
                        Style="{StaticResource NavIconPath}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{TemplateBinding IconGeometry}"/>
                  <TextBlock x:Name="Label"
                             Grid.Column="1"
                             Text="{TemplateBinding Text}"
                             Style="{DynamicResource SidebarLabelStyle}"
                             FontSize="{StaticResource Type.Body.Size}"
                             Foreground="{DynamicResource TextMain}"
                             VerticalAlignment="Center"/>
                </Grid>
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
                <Setter TargetName="ContentGrid" Property="Margin" Value="0"/>
                <Setter TargetName="ContentGrid" Property="HorizontalAlignment" Value="Center"/>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource TextMain}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1"
                                       Duration="0:0:0.09">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"
                                       Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1"
                                       Duration="0:0:0.06"/>
                      <DoubleAnimation Storyboard.TargetName="RowRoot"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="0.985"
                                       Duration="0:0:0.06"/>
                      <DoubleAnimation Storyboard.TargetName="RowRoot"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="0.985"
                                       Duration="0:0:0.06"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"
                                       Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="RowRoot"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="1"
                                       Duration="0:0:0.10"/>
                      <DoubleAnimation Storyboard.TargetName="RowRoot"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="1"
                                       Duration="0:0:0.10"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsActive" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Card}"/>
                <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource AccentIndicator}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextMain}"/>
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <!-- Cancel is tinted with soft danger surface only while a batch is running -->
              <Trigger Property="IsAlert" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DangerSoft}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
                <Setter TargetName="Chrome" Property="BorderThickness" Value="1"/>
                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Danger}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Danger}"/>
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RowRoot" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Compact utility button for the bottom Shell / Theme / Language dock -->
    <Style x:Key="SidebarUtilityDockButtonStyle" TargetType="local:IconNavButton" BasedOn="{StaticResource IconNavButtonStyle}">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="local:IconNavButton">
            <Grid x:Name="RowRoot">
              <Border x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource Corner.Md}"/>
              <Border x:Name="HoverFill" Background="{DynamicResource SidebarHover}" CornerRadius="{StaticResource Corner.Md}" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="PressedFill" Background="{DynamicResource SidebarPressed}" CornerRadius="{StaticResource Corner.Md}" Opacity="0" IsHitTestVisible="False"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                <Path x:Name="Glyph"
                      Style="{StaticResource IconPath}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="{TemplateBinding IconGeometry}"/>
                <TextBlock x:Name="Label"
                           Text="{TemplateBinding Text}"
                           FontSize="{StaticResource Type.Caption.Size}"
                           Foreground="{DynamicResource TextSub}"
                           Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverFill" Property="Opacity" Value="1"/>
                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource TextMain}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextMain}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="PressedFill" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SidebarToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
      <Setter Property="Grid.Column" Value="1"/>
      <Setter Property="Grid.ColumnSpan" Value="1"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource Corner.Md}"/>
              <Border x:Name="HoverFill" Background="{DynamicResource SidebarHover}" CornerRadius="{StaticResource Corner.Md}" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="PressedFill" Background="{DynamicResource SidebarPressed}" CornerRadius="{StaticResource Corner.Md}" Opacity="0" IsHitTestVisible="False"/>
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverFill" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="PressedFill" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
          <Setter Property="Grid.Column" Value="0"/>
          <Setter Property="Grid.ColumnSpan" Value="2"/>
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="34"/>
          <Setter Property="HorizontalAlignment" Value="Stretch"/>
          <Setter Property="Margin" Value="0"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SidebarScrollBarStyle" TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <Style x:Key="SidebarSectionHeaderStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="FontSize" Value="{StaticResource Type.Micro.Size}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="10,10,8,4"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextAlignment" Value="Left"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SidebarGroupDividerStyle" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource Divider}"/>
      <Setter Property="Margin" Value="8,6,8,4"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="8,4,8,8" ClipToBounds="True" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Row 0: Brand Header (38px sightline aligned with right TitleBar) -->
    <Grid Grid.Row="0" Height="34" Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Button x:Name="SidebarBrandLogoButton"
              Grid.Column="0"
              Click="BrandLogoButton_Click"
              ToolTip="{Binding VersionTooltip}"
              AutomationProperties.Name="{Binding VersionText}">
        <Button.Style>
          <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Grid>
                    <Border x:Name="HoverFill"
                            Background="{DynamicResource SidebarHover}"
                            CornerRadius="{StaticResource Corner.Md}"
                            Opacity="0"
                            IsHitTestVisible="False"/>
                    <Border x:Name="PressedFill"
                            Background="{DynamicResource SidebarPressed}"
                            CornerRadius="{StaticResource Corner.Md}"
                            Opacity="0"
                            IsHitTestVisible="False"/>
                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="HoverFill" Property="Opacity" Value="1"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="PressedFill" Property="Opacity" Value="1"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsOpen, ElementName=VersionPopup}" Value="True">
                <Setter Property="IsHitTestVisible" Value="False"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Width="28" Height="28" VerticalAlignment="Center">
            <Image Source="/Assets/black-kitten.png"
                   Width="24" Height="24"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
            <Ellipse Width="7" Height="7"
                     Fill="{DynamicResource AccentIndicator}"
                     Stroke="{DynamicResource Surface.Chrome}"
                     StrokeThickness="1.2"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Visibility="{Binding UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          </Grid>
          <TextBlock x:Name="SidebarBrandTitle"
                     Grid.Column="1"
                     Text="GPT Register Tool"
                     Margin="8,0,2,0"
                     FontSize="{StaticResource Type.Body.Size}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextMain}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Button>

      <Popup x:Name="VersionPopup"
             PlacementTarget="{Binding ElementName=SidebarBrandLogoButton}"
             Placement="Bottom"
             VerticalOffset="6"
             AllowsTransparency="True"
             PopupAnimation="Fade"
             StaysOpen="False">
        <Border Margin="8"
                MinWidth="224"
                Padding="12"
                Background="{DynamicResource Surface.Card}"
                BorderBrush="{DynamicResource WorkspaceFrameOutline}"
                BorderThickness="1"
                CornerRadius="{StaticResource Corner.Lg}">
          <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="16" ShadowDepth="3" Direction="270"/>
          </Border.Effect>
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="{loc:Tr Key='当前版本'}"
                         FontSize="{StaticResource Type.Caption.Size}"
                         Foreground="{DynamicResource TextMuted}"
                         VerticalAlignment="Center"/>
              <TextBlock Text="{Binding VersionText}"
                         DockPanel.Dock="Right"
                         HorizontalAlignment="Right"
                         FontFamily="{StaticResource Font.Mono}"
                         FontSize="{StaticResource Type.Caption.Size}"
                         FontWeight="SemiBold"
                         Typography.NumeralAlignment="Tabular"
                         Foreground="{DynamicResource TextMain}"
                         VerticalAlignment="Center"/>
            </DockPanel>

            <Button x:Name="VersionButton"
                    Command="{Binding CheckUpdatesCommand}"
                    ToolTip="{Binding VersionTooltip}"
                    Height="32"
                    Margin="0"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{Binding VersionText}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Style="{StaticResource ToolbarIconPath}"
                      Stroke="{DynamicResource TextMain}"
                      Data="{StaticResource Glyph.Refresh}"/>
                <TextBlock Text="{loc:Tr Key='检查更新'}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button x:Name="UpdateButton"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding OpenReleaseCommand}"
                    ToolTip="{Binding UpdateTooltip}"
                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Height="32"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Style="{StaticResource CompactIconPath}"
                      Data="{StaticResource Glyph.OpenExternal}"
                      Stroke="{DynamicResource OnPrimary}"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{Binding UpdateText}"
                           Foreground="{DynamicResource OnPrimary}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Popup>

      <Button x:Name="SidebarToggleButton" Click="Toggle_Click">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource SidebarToggleButtonStyle}">
            <Setter Property="ToolTip" Value="{loc:Tr Key='收起侧边栏'}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}}" Value="True">
                <Setter Property="ToolTip" Value="{loc:Tr Key='展开侧边栏'}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <Path HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path.Style>
            <Style TargetType="Path" BasedOn="{StaticResource NavIconPath}">
              <Setter Property="Data" Value="{StaticResource Glyph.PanelLeftClose}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}}" Value="True">
                  <Setter Property="Data" Value="{StaticResource Glyph.PanelLeftOpen}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                  <Setter Property="Stroke" Value="{DynamicResource TextMain}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Path.Style>
        </Path>
      </Button>
    </Grid>

    <!-- Row 1: Scrollable Core Workflow Navigation -->
    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
      <ScrollViewer.Resources>
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SidebarScrollBarStyle}"/>
      </ScrollViewer.Resources>
      <StackPanel Margin="0,2,0,4">
        <TextBlock Text="{loc:Tr Key='快捷操作'}" Style="{StaticResource SidebarSectionHeaderStyle}" Margin="10,2,8,4"/>
        <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Register}" Text="{loc:Tr Key='一键注册'}" Command="{Binding NavCommand}" CommandParameter="register"/>
        <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Sms}" Text="{loc:Tr Key='一键接码'}" Command="{Binding NavCommand}" CommandParameter="sms"/>
        <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Scan}" Text="{loc:Tr Key='账号测活'}" Command="{Binding NavCommand}" CommandParameter="scan"/>
        <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Promotion}" Text="{loc:Tr Key='查优惠'}" Command="{Binding NavCommand}" CommandParameter="promotion"/>
        <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.PaymentQualification}" Text="{loc:Tr Key='查支付资格'}" Command="{Binding NavCommand}" CommandParameter="paymentqualification"/>

        <Border Style="{StaticResource SidebarGroupDividerStyle}"/>
        <TextBlock Text="{loc:Tr Key='支付管理'}" Style="{StaticResource SidebarSectionHeaderStyle}"/>
        <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.PayLink}" Text="{loc:Tr Key='打开支付链接'}" Command="{Binding NavCommand}" CommandParameter="paylink"/>
        <local:IconNavButton AutomationProperties.Name="{loc:Tr Key='支付链接提取'}" Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.BatchPay}" Text="{loc:Tr Key='支付链接提取'}" Command="{Binding NavCommand}" CommandParameter="batchpay"/>

        <Border Style="{StaticResource SidebarGroupDividerStyle}"/>
        <TextBlock Text="{loc:Tr Key='邮箱管理'}" Style="{StaticResource SidebarSectionHeaderStyle}"/>
        <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.ImportMail}" Text="{loc:Tr Key='导入邮箱'}" Command="{Binding NavCommand}" CommandParameter="importmail"/>
        <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Inbox}" Text="{loc:Tr Key='查看收件箱'}" Command="{Binding NavCommand}" CommandParameter="inbox"/>
        <local:IconNavButton AutomationProperties.Name="{loc:Tr Key='邮箱换绑'}" Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.ChangeEmail}" Text="{loc:Tr Key='邮箱换绑'}" Command="{Binding NavCommand}" CommandParameter="changeemail"/>

        <Border Style="{StaticResource SidebarGroupDividerStyle}"/>
        <TextBlock Text="{loc:Tr Key='账号管理'}" Style="{StaticResource SidebarSectionHeaderStyle}"/>
        <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.ImportCpa}" Text="{loc:Tr Key='一键导入'}" Command="{Binding NavCommand}" CommandParameter="importcpa"/>
        <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Export}" Text="{loc:Tr Key='导出账号'}" Command="{Binding NavCommand}" CommandParameter="export"/>
        <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Delete}" Text="{loc:Tr Key='删除选中'}" Command="{Binding NavCommand}" CommandParameter="delete"/>

        <Border Style="{StaticResource SidebarGroupDividerStyle}"/>
        <TextBlock Text="{loc:Tr Key='工具与数据'}" Style="{StaticResource SidebarSectionHeaderStyle}"/>
        <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.ProxyPool}" Text="{loc:Tr Key='代理池管理'}" Command="{Binding NavCommand}" CommandParameter="proxypool"/>
        <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Refresh}" Text="{loc:Tr Key='刷新'}" Command="{Binding NavCommand}" CommandParameter="refresh"/>
        <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Backup}" Text="{loc:Tr Key='备份工作区'}" ToolTip="{loc:Tr Key='备份工作区'}" Command="{Binding NavCommand}" CommandParameter="backup"/>
        <local:IconNavButton Style="{StaticResource IconNavButtonStyle}" IconGeometry="{StaticResource Glyph.Restore}" Text="{loc:Tr Key='恢复工作区'}" ToolTip="{loc:Tr Key='恢复工作区'}" Command="{Binding NavCommand}" CommandParameter="restore"/>
      </StackPanel>
    </ScrollViewer>

    <!-- Row 2: Sticky Footer (Cancel Batch always reachable + Settings + Compact Dock) -->
    <StackPanel Grid.Row="2" Margin="0,4,0,0">
      <Border Height="1" Background="{DynamicResource Divider}" Margin="6,2,6,6" SnapsToDevicePixels="True"/>
      <local:IconNavButton Style="{StaticResource IconNavButtonStyle}"
                           IconGeometry="{StaticResource Glyph.CancelBatch}"
                           Text="{loc:Tr Key='取消批次'}"
                           Command="{Binding NavCommand}"
                           CommandParameter="cancelbatch"/>
      <local:IconNavButton AutomationProperties.Name="{loc:Tr Key='设置'}"
                           Style="{StaticResource IconNavButtonStyle}"
                           IconGeometry="{StaticResource Glyph.Settings}"
                           Text="{loc:Tr Key='设置'}"
                           Command="{Binding NavCommand}"
                           CommandParameter="settings"/>

      <!-- Utility Dock: horizontal 3-up strip when expanded; vertical icon stack when collapsed -->
      <UniformGrid Margin="0,4,0,0">
        <UniformGrid.Style>
          <Style TargetType="UniformGrid">
            <Setter Property="Rows" Value="1"/>
            <Setter Property="Columns" Value="3"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
                <Setter Property="Rows" Value="3"/>
                <Setter Property="Columns" Value="1"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </UniformGrid.Style>
        <local:IconNavButton Style="{StaticResource SidebarUtilityDockButtonStyle}"
                             IconGeometry="{StaticResource Glyph.Key}"
                             Text="{loc:Tr Key='外壳'}"
                             ToolTip="{loc:Tr Key='外壳设置'}"
                             Command="{Binding NavCommand}"
                             CommandParameter="shell"/>
        <local:IconNavButton Style="{StaticResource SidebarUtilityDockButtonStyle}"
                             IconGeometry="{Binding ThemeIconGeometry}"
                             Text="{loc:Tr Key='主题'}"
                             ToolTip="{Binding ThemeModeLabel}"
                             Command="{Binding NavCommand}"
                             CommandParameter="theme"/>
        <local:IconNavButton AutomationProperties.Name="{loc:Tr Key='切换语言'}"
                             Style="{StaticResource SidebarUtilityDockButtonStyle}"
                             IconGeometry="{StaticResource Glyph.Language}"
                             Text="{loc:Tr Key='语言'}"
                             ToolTip="{loc:Tr Key='切换语言'}"
                             Command="{Binding NavCommand}"
                             CommandParameter="language"/>
      </UniformGrid>
    </StackPanel>
  </Grid>
</UserControl>
