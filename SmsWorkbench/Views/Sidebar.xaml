<UserControl x:Class="SmsWorkbench.Views.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SmsWorkbench.Localization"
             xmlns:local="clr-namespace:SmsWorkbench.Views">
  <!-- Sidebar visuals only: the column width (and its animation) stays on
       MainWindow because `SidebarColumn` is a definition of the window grid.
       `IsCollapsed` drives every visual trigger; `ToggleRequested` asks the
       window to flip `SidebarCollapsed`. -->
  <UserControl.Resources>
    <local:NavKeyEqualsConverter x:Key="NavKeyEqualsConverter"/>
    <local:NavCancelAlertConverter x:Key="NavCancelAlertConverter"/>
    <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
      <!-- Self-contained: this dictionary is a UserControl's, so it cannot rely
           on the application-level implicit Button style. These five setters are
           what that style contributed before the split; the Template below
           overrides the rest. -->
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="{DynamicResource SidebarButtonBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Corner.Lg}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelHover}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelHover}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconNavButtonStyle" TargetType="local:IconNavButton">
      <!--
        A row separates from the chrome by a step in lightness, not by a stroke:
        transparent at rest, Surface.Block on hover, Surface.Card plus a primary
        bar while its action runs (IsActive). The bar is the only colour the row
        ever spends, and only on real state.
      -->
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="14,0,12,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}"/>
      <Setter Property="IsActive">
        <Setter.Value>
          <MultiBinding Converter="{StaticResource NavKeyEqualsConverter}">
            <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/>
            <Binding Path="ActiveKey" RelativeSource="{RelativeSource AncestorType=local:Sidebar}"/>
          </MultiBinding>
        </Setter.Value>
      </Setter>
      <Setter Property="IsAlert">
        <Setter.Value>
          <MultiBinding Converter="{StaticResource NavCancelAlertConverter}">
            <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/>
            <Binding Path="ActiveKey" RelativeSource="{RelativeSource AncestorType=local:Sidebar}"/>
          </MultiBinding>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="local:IconNavButton">
            <Grid x:Name="RowRoot" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
              </Grid.RenderTransform>
              <Border x:Name="Chrome"
                      Background="{TemplateBinding Background}"
                      BorderThickness="0"
                      CornerRadius="{StaticResource Corner.Lg}"/>
              <Border x:Name="HoverFill"
                      Background="{DynamicResource SidebarHover}"
                      CornerRadius="{StaticResource Corner.Lg}"
                      Opacity="0"
                      IsHitTestVisible="False"/>
              <Border x:Name="PressedFill"
                      Background="{DynamicResource SidebarPressed}"
                      CornerRadius="{StaticResource Corner.Lg}"
                      Opacity="0"
                      IsHitTestVisible="False"/>
              <Grid>
                <Border x:Name="SelectionBar"
                        Width="3"
                        Margin="0,8"
                        HorizontalAlignment="Left"
                        CornerRadius="{StaticResource Corner.Hairline}"
                        Background="{DynamicResource AccentIndicator}"
                        Visibility="Collapsed"/>
                <Grid Margin="{TemplateBinding Padding}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Path x:Name="Glyph"
                        Grid.Column="0"
                        Width="16" Height="16"
                        Stretch="Uniform"
                        Stroke="{DynamicResource TextSub}"
                        StrokeThickness="1.4"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Fill="Transparent"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="{TemplateBinding IconGeometry}"/>
                  <TextBlock x:Name="Label"
                             Grid.Column="1"
                             Text="{TemplateBinding Text}"
                             Style="{DynamicResource SidebarLabelStyle}"
                             FontSize="{StaticResource Type.Body.Size}"
                             Foreground="{DynamicResource TextMain}"
                             VerticalAlignment="Center"/>
                </Grid>
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource TextMain}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1"
                                       Duration="0:0:0.10">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"
                                       Duration="0:0:0.15">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1"
                                       Duration="0:0:0.06"/>
                      <DoubleAnimation Storyboard.TargetName="RowRoot"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="0.985"
                                       Duration="0:0:0.06"/>
                      <DoubleAnimation Storyboard.TargetName="RowRoot"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="0.985"
                                       Duration="0:0:0.06"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"
                                       Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="RowRoot"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="1"
                                       Duration="0:0:0.10"/>
                      <DoubleAnimation Storyboard.TargetName="RowRoot"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="1"
                                       Duration="0:0:0.10"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsActive" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Card}"/>
                <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource AccentIndicator}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextMain}"/>
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <!-- Cancel is tinted only while something is running: colour marks
                   state, and "nothing to cancel" is not a state worth colouring. -->
              <Trigger Property="IsAlert" Value="True">
                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Danger}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Danger}"/>
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RowRoot" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SidebarPaneBorderStyle" TargetType="Border">
      <!-- The chrome is its own surface; the divider against the content is drawn
           once by MainWindow, so the pane adds no second edge. -->
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource Corner.Xl}"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style x:Key="SidebarBrandLogoStyle" TargetType="Border">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="{DynamicResource SidebarBg}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarBrandTextPanelStyle" TargetType="StackPanel">
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Chrome"
                      Background="{TemplateBinding Background}"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      CornerRadius="{StaticResource Corner.Md}"/>
              <Border x:Name="HoverFill"
                      Background="{DynamicResource SidebarHover}"
                      CornerRadius="{StaticResource Corner.Md}"
                      Opacity="0"
                      IsHitTestVisible="False"/>
              <Border x:Name="PressedFill"
                      Background="{DynamicResource SidebarPressed}"
                      CornerRadius="{StaticResource Corner.Md}"
                      Opacity="0"
                      IsHitTestVisible="False"/>
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1"
                                       Duration="0:0:0.10"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"
                                       Duration="0:0:0.14"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1"
                                       Duration="0:0:0.06"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"
                                       Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
          <Setter Property="Margin" Value="0,0,9,0"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarScrollBarStyle" TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarSectionHeaderStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="FontSize" Value="{StaticResource Type.Caption.Size}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Opacity" Value="0.88"/>
      <Setter Property="Margin" Value="14,2,8,5"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextAlignment" Value="Left"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarGroupDividerStyle" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource Divider}"/>
      <Setter Property="Margin" Value="12,10,12,8"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
          <Setter Property="Margin" Value="8,8,8,8"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
        <Grid Margin="10,0,10,10" ClipToBounds="True" HorizontalAlignment="Stretch">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Top brand header: click the Logo / brand block to reveal current version & update check -->
          <StackPanel Grid.Row="0" Margin="0,2,0,4">
            <Border Height="50"
                    Padding="4,6"
                    Style="{StaticResource SidebarPaneBorderStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="SidebarBrandLogoButton"
                        Grid.Column="0"
                        Click="BrandLogoButton_Click"
                        ToolTip="{Binding VersionTooltip}"
                        AutomationProperties.Name="{Binding VersionText}">
                  <Button.Style>
                    <Style TargetType="Button">
                      <Setter Property="Height" Value="38"/>
                      <Setter Property="Padding" Value="4,0"/>
                      <Setter Property="Margin" Value="0"/>
                      <Setter Property="HorizontalAlignment" Value="Stretch"/>
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="BorderThickness" Value="0"/>
                      <Setter Property="Cursor" Value="Hand"/>
                      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="Button">
                            <Grid>
                              <Border x:Name="HoverFill"
                                      Background="{DynamicResource SidebarHover}"
                                      CornerRadius="{StaticResource Corner.Lg}"
                                      Opacity="0"
                                      IsHitTestVisible="False"/>
                              <Border x:Name="PressedFill"
                                      Background="{DynamicResource SidebarPressed}"
                                      CornerRadius="{StaticResource Corner.Lg}"
                                      Opacity="0"
                                      IsHitTestVisible="False"/>
                              <ContentPresenter Margin="{TemplateBinding Padding}"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <DoubleAnimation Storyboard.TargetName="HoverFill"
                                                       Storyboard.TargetProperty="Opacity"
                                                       To="1"
                                                       Duration="0:0:0.10">
                                        <DoubleAnimation.EasingFunction>
                                          <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                      </DoubleAnimation>
                                    </Storyboard>
                                  </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <DoubleAnimation Storyboard.TargetName="HoverFill"
                                                       Storyboard.TargetProperty="Opacity"
                                                       To="0"
                                                       Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction>
                                          <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                      </DoubleAnimation>
                                    </Storyboard>
                                  </BeginStoryboard>
                                </Trigger.ExitActions>
                              </Trigger>
                              <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <DoubleAnimation Storyboard.TargetName="PressedFill"
                                                       Storyboard.TargetProperty="Opacity"
                                                       To="1"
                                                       Duration="0:0:0.06"/>
                                    </Storyboard>
                                  </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <DoubleAnimation Storyboard.TargetName="PressedFill"
                                                       Storyboard.TargetProperty="Opacity"
                                                       To="0"
                                                       Duration="0:0:0.12"/>
                                    </Storyboard>
                                  </BeginStoryboard>
                                </Trigger.ExitActions>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpen, ElementName=VersionPopup}" Value="True">
                          <Setter Property="IsHitTestVisible" Value="False"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}, FallbackValue=False}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="30" Height="30" VerticalAlignment="Center">
                      <!-- The PNG (1024x1024) instead of app-icon.ico: HighQuality (Fant)
                           plus an even 24px keeps the strokes crisp at every DPI. -->
                      <Image Source="/Assets/black-kitten.png"
                             Width="24" Height="24"
                             Stretch="Uniform"
                             RenderOptions.BitmapScalingMode="HighQuality"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                      <Ellipse Width="7" Height="7"
                               Fill="{DynamicResource AccentIndicator}"
                               Stroke="{DynamicResource Surface.Chrome}"
                               StrokeThickness="1.2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Visibility="{Binding UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                    <TextBlock x:Name="SidebarBrandTitle"
                               Grid.Column="1"
                               Text="GPT Register Tool"
                               Margin="8,0,4,0"
                               FontSize="{StaticResource Type.Body.Size}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMain}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </Button>

                <Popup x:Name="VersionPopup"
                       PlacementTarget="{Binding ElementName=SidebarBrandLogoButton}"
                       Placement="Bottom"
                       VerticalOffset="4"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       StaysOpen="False">
                  <Border Margin="8"
                          MinWidth="220"
                          Padding="12"
                          Background="{DynamicResource Surface.Card}"
                          BorderBrush="{DynamicResource LineStrong}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource Corner.Lg}">
                    <Border.Effect>
                      <DropShadowEffect Color="#33000000" BlurRadius="14" ShadowDepth="2" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                      <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="{loc:Tr Key='当前版本'}"
                                   FontSize="{StaticResource Type.Caption.Size}"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding VersionText}"
                                   DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="{StaticResource Type.Caption.Size}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}"
                                   VerticalAlignment="Center"/>
                      </DockPanel>

                      <Button x:Name="VersionButton"
                              Command="{Binding CheckUpdatesCommand}"
                              ToolTip="{Binding VersionTooltip}"
                              Height="32"
                              Margin="0"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{Binding VersionText}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Path Style="{StaticResource IconPath}"
                                Width="13" Height="13"
                                Stroke="{DynamicResource TextMain}"
                                Data="{StaticResource Glyph.Refresh}"/>
                          <TextBlock Text="{loc:Tr Key='检查更新'}"
                                     Margin="6,0,0,0"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>

                      <Button x:Name="UpdateButton"
                              Style="{StaticResource PrimaryButton}"
                              Command="{Binding OpenReleaseCommand}"
                              ToolTip="{Binding UpdateTooltip}"
                              Visibility="{Binding UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Height="32"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Path Width="12" Height="12" Stretch="Uniform"
                                Data="{StaticResource Glyph.OpenExternal}"
                                Stroke="{DynamicResource OnPrimary}"
                                StrokeThickness="1.6"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding UpdateText}"
                                     Foreground="{DynamicResource OnPrimary}"
                                     Margin="6,0,0,0"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Border>
                </Popup>

                <Button x:Name="SidebarToggleButton" Grid.Column="1" Click="Toggle_Click">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SidebarToggleButtonStyle}">
                      <Setter Property="ToolTip" Value="{loc:Tr Key='收起侧边栏'}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType=local:Sidebar}}" Value="True">
                          <Setter Property="ToolTip" Value="{loc:Tr Key='展开侧边栏'}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <Path Width="16" Height="16" Stretch="Uniform"
                        Stroke="{DynamicResource TextSub}" StrokeThickness="1.25"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path.Style>
                      <Style TargetType="Path">
                        <Setter Property="Data" Value="M5 4H19A1 1 0 0 1 20 5V19A1 1 0 0 1 19 20H5A1 1 0 0 1 4 19V5A1 1 0 0 1 5 4Z M10 4V20"/>
                        <Style.Triggers>
