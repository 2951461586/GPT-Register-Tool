<UserControl x:Class="SmsWorkbench.AccountFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SmsWorkbench.Localization">
  <!-- Account counters + search/scope/page-size/paging bar. DataContext is the
       MainWindow itself, inherited from the parent, so every binding keeps the
       `Pool.*` path it had before the extraction. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

          <!-- Four stat tiles. Structure comes from the surface ladder, not a
               stroke: Surface.Card is lighter than the page in light and darker than
               it in dark, which is the whole separation. Phase 1 removed the
               structural borders; these five survived it (see
               docs/audits/plans/plan-2026-10-28-wpf-visual-system.md). -->
          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="12,10" CornerRadius="{StaticResource Corner.Xl}" Background="{DynamicResource Surface.Card}">
              <StackPanel Orientation="Horizontal">
                <StackPanel>
                  <TextBlock Text="{loc:Tr Key='总记录'}" FontSize="{StaticResource Type.Caption.Size}" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding Pool.TotalCountText}" FontSize="{StaticResource Type.Display.Size}" FontWeight="Bold"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="0,0,8,0" Padding="12,10" CornerRadius="{StaticResource Corner.Xl}" Background="{DynamicResource Surface.Card}">
              <StackPanel Orientation="Horizontal">
                <StackPanel>
                  <TextBlock Text="{loc:Tr Key='有试用'}" FontSize="{StaticResource Type.Caption.Size}" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding Pool.TrialCountText}" FontSize="{StaticResource Type.Display.Size}" FontWeight="Bold"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="0,0,8,0" Padding="12,10" CornerRadius="{StaticResource Corner.Xl}" Background="{DynamicResource Surface.Card}">
              <StackPanel Orientation="Horizontal">
                <StackPanel>
                  <TextBlock Text="{loc:Tr Key='已注册'}" FontSize="{StaticResource Type.Caption.Size}" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding Pool.RegisteredCountText}" FontSize="{StaticResource Type.Display.Size}" FontWeight="Bold"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Padding="12,10" CornerRadius="{StaticResource Corner.Xl}" Background="{DynamicResource Surface.Card}">
              <StackPanel Orientation="Horizontal">
                <StackPanel>
                  <TextBlock Text="{loc:Tr Key='异常/待处理'}" FontSize="{StaticResource Type.Caption.Size}" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding Pool.AttentionCountText}" FontSize="{StaticResource Type.Display.Size}" FontWeight="Bold"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>

          <Border Grid.Row="1" Margin="0,0,0,8" Padding="8" CornerRadius="{StaticResource Corner.Lg}" Background="{DynamicResource Surface.Card}">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0" MinWidth="460">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="260"/>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="96"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                  <TextBox Style="{StaticResource SearchTextBox}" Text="{Binding Pool.SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Tr Key='搜索邮箱、session、token、备注'}"/>
                  <Path Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                        Data="{StaticResource Glyph.Search}"
                        Stroke="{DynamicResource TextMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                        IsHitTestVisible="False"/>
                  <Button Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                          Padding="0" Background="Transparent" BorderThickness="0" ToolTip="{loc:Tr Key='清除搜索'}"
                          Command="{Binding Pool.ClearSearchCommand}"
                          Visibility="{Binding Pool.HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="ClearBg" Background="Transparent" CornerRadius="{StaticResource Corner.Sm}">
                          <Path Width="10" Height="10" Stretch="Uniform" Data="{StaticResource Glyph.Close}"
                                Stroke="{DynamicResource TextMuted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ClearBg" Property="Background" Value="{DynamicResource PanelHover}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </Grid>
                <ComboBox Grid.Column="1" Margin="8,0,0,0"
                          ItemsSource="{Binding Pool.ScopeOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding Pool.ScopeFilter, Mode=TwoWay}"
                          ToolTip="{loc:Tr Key='筛选范围'}"/>
                <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding Pool.PageSizeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Tr Key='每页条数'}"/>
                <TextBlock Grid.Column="3" Margin="12,0,0,0" Text="{Binding Pool.PageStatusText}" VerticalAlignment="Center" Foreground="{DynamicResource TextSub}"/>
              </Grid>
              <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Margin="2,0" Command="{Binding Pool.FirstPageCommand}" ToolTip="{loc:Tr Key='首页'}">
                  <Path Style="{StaticResource ToolbarIconPath}"
                        Data="{StaticResource Glyph.FirstPage}"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="2,0" Command="{Binding Pool.PreviousPageCommand}" ToolTip="{loc:Tr Key='上一页'}">
                  <Path Style="{StaticResource ToolbarIconPath}"
                        Data="{StaticResource Glyph.PrevPage}"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="2,0" Command="{Binding Pool.ClearSelectionCommand}" ToolTip="{loc:Tr Key='清空选择'}">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource ToolbarIconPath}"
                          Data="{StaticResource Glyph.SelectAllFiltered}"/>
                    <TextBlock Text="{loc:Tr Key='清空'}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource Type.Body.Size}"/>
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="2,0" Command="{Binding Pool.NextPageCommand}" ToolTip="{loc:Tr Key='下一页'}">
                  <Path Style="{StaticResource ToolbarIconPath}"
                        Data="{StaticResource Glyph.NextPage}"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="2,0" Command="{Binding Pool.LastPageCommand}" ToolTip="{loc:Tr Key='末页'}">
                  <Path Style="{StaticResource ToolbarIconPath}"
                        Data="{StaticResource Glyph.LastPage}"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="6,0,2,0" Command="{Binding Pool.SelectAllFilteredCommand}" ToolTip="{loc:Tr Key='选中当前筛选结果'}">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource ToolbarIconPath}"
                          Data="{StaticResource Glyph.SelectAllFiltered}"/>
                    <TextBlock Text="{loc:Tr Key='全选'}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource Type.Body.Size}"/>
                  </StackPanel>
                </Button>
              </WrapPanel>
            </Grid>
          </Border>
  </Grid>
</UserControl>
