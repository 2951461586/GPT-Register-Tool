<UserControl x:Class="SmsWorkbench.AccountFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SmsWorkbench.Localization">
  <!-- Account counters + search/scope/page-size/paging bar. DataContext is the
       MainWindow itself, inherited from the parent, so every binding keeps the
       `Pool.*` path it had before the extraction. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="12,10" CornerRadius="4" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <StackPanel>
                  <TextBlock Text="{loc:Tr Key='总记录'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding Pool.TotalCountText}" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="0,0,8,0" Padding="12,10" CornerRadius="4" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <StackPanel>
                  <TextBlock Text="{loc:Tr Key='有试用'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding Pool.TrialCountText}" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="0,0,8,0" Padding="12,10" CornerRadius="4" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <StackPanel>
                  <TextBlock Text="{loc:Tr Key='已注册'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding Pool.RegisteredCountText}" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Padding="12,10" CornerRadius="4" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <StackPanel>
                  <TextBlock Text="{loc:Tr Key='异常/待处理'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding Pool.AttentionCountText}" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>

          <Border Grid.Row="1" Margin="0,0,0,8" Padding="8" CornerRadius="4" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0" MinWidth="460">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="260"/>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="96"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                  <TextBox Style="{StaticResource SearchTextBox}" Text="{Binding Pool.SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Tr Key='搜索邮箱、session、token、备注'}"/>
                  <Path Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                        Data="M11 3a8 8 0 1 0 0 16 8 8 0 0 0 0-16z M21 21l-4.35-4.35"
                        Stroke="{DynamicResource TextMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                        IsHitTestVisible="False"/>
                  <Button Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                          Padding="0" Background="Transparent" BorderThickness="0" ToolTip="{loc:Tr Key='清除搜索'}"
                          Command="{Binding Pool.ClearSearchCommand}"
                          Visibility="{Binding Pool.HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="ClearBg" Background="Transparent" CornerRadius="4">
                          <Path Width="10" Height="10" Stretch="Uniform" Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                Stroke="{DynamicResource TextMuted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ClearBg" Property="Background" Value="{DynamicResource PanelHover}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </Grid>
                <ComboBox Grid.Column="1" Margin="8,0,0,0"
                          ItemsSource="{Binding Pool.ScopeOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding Pool.ScopeFilter, Mode=TwoWay}"
                          ToolTip="{loc:Tr Key='筛选范围'}"/>
                <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding Pool.PageSizeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Tr Key='每页条数'}"/>
                <TextBlock Grid.Column="3" Margin="12,0,0,0" Text="{Binding Pool.PageStatusText}" VerticalAlignment="Center" Foreground="{DynamicResource TextSub}"/>
              </Grid>
              <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Margin="2,0" Command="{Binding Pool.FirstPageCommand}" ToolTip="{loc:Tr Key='首页'}">
                  <Path Style="{StaticResource ToolbarIconPath}"
                        Data="M11 19l-7-7 7-7 M19 19l-7-7 7-7"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="2,0" Command="{Binding Pool.PreviousPageCommand}" ToolTip="{loc:Tr Key='上一页'}">
                  <Path Style="{StaticResource ToolbarIconPath}"
                        Data="M15 18l-6-6 6-6"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="2,0" Command="{Binding Pool.ClearSelectionCommand}" ToolTip="{loc:Tr Key='清空选择'}">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource ToolbarIconPath}"
                          Data="M9 11l3 3l8-8 M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                    <TextBlock Text="{loc:Tr Key='清空'}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="2,0" Command="{Binding Pool.NextPageCommand}" ToolTip="{loc:Tr Key='下一页'}">
                  <Path Style="{StaticResource ToolbarIconPath}"
                        Data="M9 18l6-6-6-6"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="2,0" Command="{Binding Pool.LastPageCommand}" ToolTip="{loc:Tr Key='末页'}">
                  <Path Style="{StaticResource ToolbarIconPath}"
                        Data="M13 5l7 7-7 7 M5 5l7 7-7 7"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="6,0,2,0" Command="{Binding Pool.SelectAllFilteredCommand}" ToolTip="{loc:Tr Key='选中当前筛选结果'}">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource ToolbarIconPath}"
                          Data="M9 11l3 3l8-8 M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                    <TextBlock Text="{loc:Tr Key='全选'}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                  </StackPanel>
                </Button>
              </WrapPanel>
            </Grid>
          </Border>
  </Grid>
</UserControl>
