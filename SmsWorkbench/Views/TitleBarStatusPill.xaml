<UserControl x:Class="SmsWorkbench.Views.TitleBarStatusPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SmsWorkbench.Localization">
  <!-- Ambient batch status pill: hidden at rest to keep the top chrome calm;
       appears cleanly while a background batch runs. -->
  <Border HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Margin="4,0,0,0"
          Padding="10,3"
          CornerRadius="{StaticResource Corner.Lg}"
          Background="{DynamicResource Surface.Card}"
          BorderBrush="{DynamicResource WorkspaceFrameOutline}"
          BorderThickness="1"
          IsHitTestVisible="False">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Visibility" Value="Visible"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding ActiveNavKey, RelativeSource={RelativeSource AncestorType=Window}}" Value="">
            <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding ActiveNavKey, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Ellipse Width="6"
               Height="6"
               Fill="{DynamicResource AccentIndicator}"
               VerticalAlignment="Center"
               Margin="0,0,7,0"/>
      <TextBlock Text="{loc:Tr Key='批次运行中'}"
                 Style="{StaticResource Text.Caption}"
                 Foreground="{DynamicResource TextMain}"
                 VerticalAlignment="Center"/>
    </StackPanel>
  </Border>
</UserControl>
