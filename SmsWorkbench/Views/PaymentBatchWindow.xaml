<Window x:Class="SmsWorkbench.Views.PaymentBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:SmsWorkbench.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmsWorkbench.Views"
        Title="{loc:Tr Key='支付链接提取'}"
        Width="1120"
        Height="900"
        MinWidth="920"
        MinHeight="760"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{loc:Tr Key='支付链接提取'}" FontSize="{StaticResource Type.Title.Size}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding AccountSummary}" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center"/>
    </Grid>

    <Border Grid.Row="1"
            Margin="0,0,0,12"
            Padding="16,14"
            CornerRadius="{StaticResource Corner.Xl}"
            Background="{DynamicResource Surface.Card}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 提链服务器配置（统一对接外部提链服务器；CDK 仅通过环境变量安全传递） -->
      <Border Grid.Row="0" Grid.ColumnSpan="4"
              Margin="0,0,0,10"
              Padding="12,10"
              CornerRadius="{StaticResource Corner.Lg}"
              Background="{DynamicResource Surface.Block}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="0.7*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,6">
            <TextBlock Text="{loc:Tr Key='服务器地址'}" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding ExtractServerApiBase, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Mono.Size}"
                     ToolTip="{loc:Tr Key='提链服务器完整地址（含协议前缀）'}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,8,6">
            <TextBlock Text="{loc:Tr Key='提链 CDK'}" Style="{StaticResource FieldLabel}"/>
            <PasswordBox local:PasswordBoxBinding.BoundPassword="{Binding ExtractServerCdk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{loc:Tr Key='CDK 密钥（通过环境变量安全传递）'}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="0,0,8,6">
            <TextBlock Text="{loc:Tr Key='提链路径'}" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding ExtractServerEndpoint, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Mono.Size}"/>
          </StackPanel>
          <StackPanel Grid.Column="3" Margin="0,0,8,6">
            <TextBlock Text="{loc:Tr Key='提链超时秒'}" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding ExtractServerTimeoutText, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <Button Grid.Column="4"
                  Content="{loc:Tr Key='保存提链配置'}"
                  Command="{Binding SaveExtractServerConfigurationCommand}"
                  VerticalAlignment="Bottom"
                  Margin="0,0,0,6"
                  MinWidth="96"/>
          <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal">
            <CheckBox Content="{loc:Tr Key='透传代理到提链服务器'}" IsChecked="{Binding ExtractServerPassProxy}" Margin="0,0,22,0"/>
            <CheckBox Content="{loc:Tr Key='校验证书 (TLS)'}" IsChecked="{Binding ExtractServerVerifyTls}"/>
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="0,0,7,10">
        <TextBlock Text="{loc:Tr Key='支付方式'}" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding PaymentMethodOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedMethod}"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1" Margin="7,0,7,10">
        <TextBlock Text="{loc:Tr Key='并发'}" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding WorkerOptions}" SelectedItem="{Binding Workers}"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="2" Margin="7,0,7,10">
        <TextBlock Text="{loc:Tr Key='瞬态重试'}" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding RetryOptions}" SelectedItem="{Binding Retries}"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="3" Margin="7,0,0,10">
        <TextBlock Text="{loc:Tr Key='Canary 数量（0=全部）'}" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding CanaryText, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>

      <!-- 可选代理池：用于透传代理给提链服务器或执行仅能力探测 -->
      <Expander Grid.Row="2" Grid.ColumnSpan="4"
                Header="{loc:Tr Key='可选代理池配置（透传代理 / 能力探测用）'}"
                IsExpanded="False"
                Margin="0,0,0,10">
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,7,10">
            <TextBlock Text="{loc:Tr Key='Checkout 代理池（host:port:user:password；支持 http/https/socks5/socks5h）'}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
            <TextBox Text="{Binding CheckoutProxyPool, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Mono.Size}"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     Height="62"
                     VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="{Binding CheckoutRegionSummary, Converter={StaticResource PoolSummaryConverter}}" Foreground="{DynamicResource TextSub}" FontSize="{StaticResource Type.Caption.Size}" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Margin="7,0,0,10">
            <TextBlock Text="{loc:Tr Key='Approve / Update 代理池（host:port:user:password；支持 http/https/socks5/socks5h）'}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
            <TextBox Text="{Binding ApproveProxyPool, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Mono.Size}"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     Height="62"
                     VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="{Binding ApproveRegionSummary, Converter={StaticResource PoolSummaryConverter}}" Foreground="{DynamicResource TextSub}" FontSize="{StaticResource Type.Caption.Size}" Margin="0,3,0,0"/>
          </StackPanel>

          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,7,4">
            <TextBlock Text="{loc:Tr Key='Checkout 出口国家（默认跟随账单区）'}" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding CheckoutCountryOptions}"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="Code"
                      SelectedValue="{Binding CheckoutProxyCountry, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="7,0,0,4">
            <TextBlock Text="{loc:Tr Key='Approve / Update 出口国家'}" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding ApproveCountryOptions}"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="Code"
                      SelectedValue="{Binding ApproveProxyCountry, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
        </Grid>
      </Expander>

      <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,2,0,8">
        <CheckBox Content="{loc:Tr Key='401 自动恢复（RT/Cookie/邮箱OTP/OAuth）'}" IsChecked="{Binding JitRefresh}" Margin="0,0,22,0"/>
        <CheckBox Content="{loc:Tr Key='仅能力探测（Checkout + Stripe init）'}" IsChecked="{Binding ProbeOnly}" Margin="0,0,22,0"/>
        <CheckBox Content="{loc:Tr Key='要求 0 元金额'}" IsChecked="{Binding RequireZero}" IsEnabled="{Binding RequireZeroEnabled}"/>
        <CheckBox Content="{loc:Tr Key='恢复已有断点'}" IsChecked="{Binding ResumeCheckpoint}" Margin="22,0,0,0"/>
        <TextBlock Text="{Binding ExecutionModeSummary}" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center" Margin="10,0,0,0"/>
      </StackPanel>

      <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Margin="0,0,0,10">
        <TextBlock Text="{loc:Tr Key='未选择邮箱时，可输入 Access Token（每行一个，最多 10 个）'}" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding ManualAccessTokens, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 Height="72"
                 FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Mono.Size}"
                 VerticalScrollBarVisibility="Auto"
                 ToolTip="{loc:Tr Key='每行一个 JWT Access Token；选择了邮箱时此项不会参与任务'}"/>
      </StackPanel>
      <StackPanel Grid.Row="5" Grid.ColumnSpan="4" Orientation="Horizontal">
        <TextBlock Text="{loc:Tr Key='批次 ID'}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox Text="{Binding BatchId, UpdateSourceTrigger=PropertyChanged}" Width="300" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Mono.Size}"/>
        <TextBlock Text="{loc:Tr Key='仅勾选“恢复已有断点”时复用此 ID'}" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>
    </Grid>
    </Border>

    <!-- 账号地区 / 支付资格矩阵已移除：所有账号统一使用上方设置的代理地区。 -->

    <Border Grid.Row="2"
            Margin="0,0,0,12"
            CornerRadius="{StaticResource Corner.Xl}"
            Background="{DynamicResource Surface.Card}">
        <DataGrid x:Name="ResultsGrid"
                ItemsSource="{Binding Results}"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                HeadersVisibility="Column"
                RowHeight="40"
                Margin="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{loc:Tr Key='账号'}" Binding="{Binding AccountRef}" Width="135"/>
          <DataGridTextColumn Header="{loc:Tr Key='结果'}" Binding="{Binding ResultStatus}" Width="72"/>
          <DataGridTextColumn Header="{loc:Tr Key='进度'}" Binding="{Binding ProgressText}" Width="64"/>
          <DataGridTextColumn Header="{loc:Tr Key='阶段'}" Binding="{Binding CurrentStage}" Width="110"/>
          <DataGridTextColumn x:Name="AuthorizationQueueColumn" Header="{loc:Tr Key='BA授权队列'}" Binding="{Binding AuthorizationDisplay}" Width="92"/>
          <DataGridTemplateColumn Header="{loc:Tr Key='阶段进度'}" Width="125">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="10" Margin="6,0" VerticalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{loc:Tr Key='支付链接 / 二维码'}" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Grid Margin="6,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ResultKind}"
                             Foreground="{DynamicResource TextSub}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                  <TextBlock Grid.Column="1"
                             Text="{Binding ResultDisplay}"
                             ToolTip="{Binding ResultDisplay}"
                             FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Mono.Size}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"/>
                  <Button Grid.Column="2"
                          Style="{StaticResource GhostToolbarButton}"
                          Width="28"
                          Height="26"
                          Padding="0"
                          Margin="8,0,0,0"
                          Command="{Binding DataContext.CopyResultCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding HasCopyableResult}"
                          ToolTip="{Binding CopyToolTip}">
                    <Path Style="{StaticResource ToolbarIconPath}" Data="{StaticResource Glyph.Copy}"/>
                  </Button>
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{loc:Tr Key='重试次数'}" Binding="{Binding Attempts}" Width="72"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="{loc:Tr Key='测试代理'}" Command="{Binding TestProxiesCommand}" MinWidth="84" Margin="0,0,8,0"/>
        <Button Content="{loc:Tr Key='保存代理配置'}" Command="{Binding SaveProxyConfigurationCommand}" MinWidth="108" Margin="0,0,8,0"/>
        <Button Content="{loc:Tr Key='打开报告'}" Command="{Binding OpenReportCommand}" MinWidth="84" Margin="0,0,8,0"/>
        <Button Content="{loc:Tr Key='取消'}" Command="{Binding RunCancelCommand}" MinWidth="72" Margin="0,0,8,0"/>
        <Button Content="{loc:Tr Key='开始执行'}" Command="{Binding RunCommand}" MinWidth="96" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
        <Button Content="{loc:Tr Key='关闭'}" MinWidth="72" IsCancel="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
