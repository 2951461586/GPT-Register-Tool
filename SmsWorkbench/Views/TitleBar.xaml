<UserControl x:Class="SmsWorkbench.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SmsWorkbench.Localization">
  <!-- Custom title bar with SVG icon buttons. The window handlers live in
       TitleBar.xaml.cs and resolve the host through Window.GetWindow(this),
       so this control owns no state of its own. -->
      <Grid Height="48" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- App title (left side, optional) -->
        <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource TextMuted}"
                   Text="GRT"/>

        <!-- Window control buttons -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
          <!-- Minimize button -->
          <Button x:Name="MinimizeButton"
                  Width="46" Height="32"
                  WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="MinimizeButton_Click"
                  ToolTip="{loc:Tr Key='最小化'}"
                  BorderThickness="0" Padding="0"
                  Background="Transparent">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="BtnBg" Background="Transparent">
                  <Path Width="12" Height="1" Stretch="Uniform"
                        Data="{StaticResource Glyph.WindowMinimize}"
                        Stroke="{DynamicResource TextSub}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource PanelHover}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>

          <!-- Maximize/Restore button -->
          <Button x:Name="MaximizeButton"
                  Width="46" Height="32"
                  WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="MaximizeButton_Click"
                  ToolTip="{loc:Tr Key='最大化'}"
                  BorderThickness="0" Padding="0"
                  Background="Transparent">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="BtnBg" Background="Transparent">
                  <Path Width="12" Height="12" Stretch="Uniform"
                        Data="{StaticResource Glyph.WindowMaximize}"
                        Stroke="{DynamicResource TextSub}"
                        StrokeThickness="1.2"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource PanelHover}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>

          <!-- Close button -->
          <Button x:Name="CloseButton"
                  Width="46" Height="32"
                  WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="CloseButton_Click"
                  ToolTip="{loc:Tr Key='关闭'}"
                  BorderThickness="0" Padding="0"
                  Background="Transparent">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="BtnBg" Background="Transparent">
                  <Path x:Name="CloseIcon" Width="10" Height="10" Stretch="Uniform"
                        Data="{StaticResource Glyph.Close}"
                        Stroke="{DynamicResource TextSub}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource Danger}"/>
                    <Setter TargetName="CloseIcon" Property="Stroke" Value="#FFFFFF"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>

        <!-- The one stroke the chrome keeps: its edge against the content. -->
        <Border Grid.ColumnSpan="2"
                Height="1"
                VerticalAlignment="Bottom"
                Background="{DynamicResource Divider}"/>
      </Grid>
</UserControl>
