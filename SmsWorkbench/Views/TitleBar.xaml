<UserControl x:Class="SmsWorkbench.Views.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmsWorkbench.Views"
             xmlns:loc="clr-namespace:SmsWorkbench.Localization">
  <!-- Minimal frameless chrome title bar (DeepAI Code style): sits directly on
       Surface.Chrome above the floating framed workspace sheet. Left carries a
       drag surface with TitleBarStatusPill (visible only while a batch is
       active); right carries three identical 46x38 OS caption buttons sharing
       one parameterized ControlTemplate (Background=hover fill, BorderBrush=
       pressed fill, Foreground=hover glyph stroke, Tag=Path Geometry). -->
  <UserControl.Resources>
    <Style x:Key="CaptionWindowButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource WindowControlHover}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource WindowControlPressed}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="Cursor" Value="Arrow"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="HoverFill"
                      Background="{TemplateBinding Background}"
                      Opacity="0"
                      IsHitTestVisible="False"/>
              <Border x:Name="PressedFill"
                      Background="{TemplateBinding BorderBrush}"
                      Opacity="0"
                      IsHitTestVisible="False"/>
              <Path x:Name="GlyphPath"
                    Width="10"
                    Height="10"
                    Stretch="None"
                    SnapsToDevicePixels="True"
                    Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                    Stroke="{DynamicResource IconMuted}"
                    StrokeThickness="{StaticResource Icon.Stroke.Chrome}"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Path.RenderTransform>
              </Path>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="GlyphPath" Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1"
                                       Duration="{StaticResource Motion.Fast}">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"
                                       Duration="{StaticResource Motion.Normal}">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="GlyphPath" Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1"
                                       Duration="{StaticResource Motion.Press}"/>
                      <DoubleAnimation Storyboard.TargetName="GlyphPath"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="0.9"
                                       Duration="{StaticResource Motion.Press}"/>
                      <DoubleAnimation Storyboard.TargetName="GlyphPath"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="0.9"
                                       Duration="{StaticResource Motion.Press}"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"
                                       Duration="{StaticResource Motion.Normal}"/>
                      <DoubleAnimation Storyboard.TargetName="GlyphPath"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="1"
                                       Duration="{StaticResource Motion.Fast}"/>
                      <DoubleAnimation Storyboard.TargetName="GlyphPath"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="1"
                                       Duration="{StaticResource Motion.Fast}"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerCaptionWindowButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionWindowButtonStyle}">
      <Setter Property="Background" Value="{DynamicResource Danger}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DangerPressed}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnDanger}"/>
    </Style>
  </UserControl.Resources>

  <Grid Height="38" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <local:TitleBarStatusPill Grid.Column="0"/>

    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
      <Button x:Name="MinimizeButton"
              Style="{StaticResource CaptionWindowButtonStyle}"
              Tag="{StaticResource Glyph.WindowMinimize}"
              Click="MinimizeButton_Click"
              ToolTip="{loc:Tr Key='最小化'}"/>

      <Button x:Name="MaximizeButton"
              Click="MaximizeButton_Click">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource CaptionWindowButtonStyle}">
            <Setter Property="Tag" Value="{StaticResource Glyph.WindowMaximize}"/>
            <Setter Property="ToolTip" Value="{loc:Tr Key='最大化'}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsWindowMaximized, RelativeSource={RelativeSource AncestorType=local:TitleBar}}" Value="True">
                <Setter Property="Tag" Value="{StaticResource Glyph.WindowRestore}"/>
                <Setter Property="ToolTip" Value="{loc:Tr Key='还原'}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>

      <Button x:Name="CloseButton"
              Style="{StaticResource DangerCaptionWindowButtonStyle}"
              Tag="{StaticResource Glyph.WindowClose}"
              Click="CloseButton_Click"
              ToolTip="{loc:Tr Key='关闭'}"/>
    </StackPanel>
  </Grid>
</UserControl>
