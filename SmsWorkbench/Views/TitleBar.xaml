<UserControl x:Class="SmsWorkbench.Views.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmsWorkbench.Views"
             xmlns:loc="clr-namespace:SmsWorkbench.Localization">
  <!-- Minimal frameless title bar: full-width drag surface on the left and
       three identically sized, identically animated window caption buttons
       (minimize / maximize-restore / close) on the right. Version and update
       controls live in the Sidebar bottom logo footer. -->
  <UserControl.Resources>
    <!-- Explicit style (not BasedOn the app-wide Button style, which pins Height=32)
         so all three caption buttons stretch to the exact same full bar height and
         share identical hover/press animations. -->
    <Style x:Key="CaptionWindowButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Arrow"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>
  </UserControl.Resources>

  <Grid Height="40" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- Window control buttons: unified 46x39 flush hit targets above the 1px divider,
         uniform 10x10 optical glyphs (1.15px stroke), and identical opacity/scale motion. -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="0,0,0,1">
      <!-- Minimize button -->
      <Button x:Name="MinimizeButton"
              Style="{StaticResource CaptionWindowButtonStyle}"
              Click="MinimizeButton_Click"
              ToolTip="{loc:Tr Key='最小化'}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="HoverFill"
                      Background="{DynamicResource WindowControlHover}"
                      Opacity="0"
                      IsHitTestVisible="False"/>
              <Border x:Name="PressedFill"
                      Background="{DynamicResource WindowControlPressed}"
                      Opacity="0"
                      IsHitTestVisible="False"/>
              <Path x:Name="GlyphPath"
                    Width="10"
                    Height="10"
                    Stretch="None"
                    SnapsToDevicePixels="True"
                    Data="{StaticResource Glyph.WindowMinimize}"
                    Stroke="{DynamicResource TextSub}"
                    StrokeThickness="1.15"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Path.RenderTransform>
              </Path>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="GlyphPath" Property="Stroke" Value="{DynamicResource TextMain}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1"
                                       Duration="0:0:0.11">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"
                                       Duration="0:0:0.15">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1"
                                       Duration="0:0:0.06"/>
                      <DoubleAnimation Storyboard.TargetName="GlyphPath"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="0.9"
                                       Duration="0:0:0.06"/>
                      <DoubleAnimation Storyboard.TargetName="GlyphPath"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="0.9"
                                       Duration="0:0:0.06"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"
                                       Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="GlyphPath"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="1"
                                       Duration="0:0:0.10"/>
                      <DoubleAnimation Storyboard.TargetName="GlyphPath"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="1"
                                       Duration="0:0:0.10"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>

      <!-- Maximize / Restore button -->
      <Button x:Name="MaximizeButton"
              Click="MaximizeButton_Click">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource CaptionWindowButtonStyle}">
            <Setter Property="ToolTip" Value="{loc:Tr Key='最大化'}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsWindowMaximized, RelativeSource={RelativeSource AncestorType=local:TitleBar}}" Value="True">
                <Setter Property="ToolTip" Value="{loc:Tr Key='还原'}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="HoverFill"
                      Background="{DynamicResource WindowControlHover}"
                      Opacity="0"
                      IsHitTestVisible="False"/>
              <Border x:Name="PressedFill"
                      Background="{DynamicResource WindowControlPressed}"
                      Opacity="0"
                      IsHitTestVisible="False"/>
              <Path x:Name="GlyphPath"
                    Width="10"
                    Height="10"
                    Stretch="None"
                    SnapsToDevicePixels="True"
                    Data="{StaticResource Glyph.WindowMaximize}"
                    Stroke="{DynamicResource TextSub}"
                    StrokeThickness="1.15"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Path.RenderTransform>
              </Path>
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsWindowMaximized, RelativeSource={RelativeSource AncestorType=local:TitleBar}}" Value="True">
                <Setter TargetName="GlyphPath" Property="Data" Value="{StaticResource Glyph.WindowRestore}"/>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="GlyphPath" Property="Stroke" Value="{DynamicResource TextMain}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1"
                                       Duration="0:0:0.11">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"
                                       Duration="0:0:0.15">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1"
                                       Duration="0:0:0.06"/>
                      <DoubleAnimation Storyboard.TargetName="GlyphPath"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="0.9"
                                       Duration="0:0:0.06"/>
                      <DoubleAnimation Storyboard.TargetName="GlyphPath"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="0.9"
                                       Duration="0:0:0.06"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"
                                       Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="GlyphPath"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="1"
                                       Duration="0:0:0.10"/>
                      <DoubleAnimation Storyboard.TargetName="GlyphPath"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="1"
                                       Duration="0:0:0.10"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>

      <!-- Close button -->
      <Button x:Name="CloseButton"
              Style="{StaticResource CaptionWindowButtonStyle}"
              Click="CloseButton_Click"
              ToolTip="{loc:Tr Key='关闭'}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="HoverFill"
                      Background="{DynamicResource Danger}"
                      Opacity="0"
                      IsHitTestVisible="False"/>
              <Border x:Name="PressedFill"
                      Background="{DynamicResource DangerPressed}"
                      Opacity="0"
                      IsHitTestVisible="False"/>
              <Path x:Name="CloseIcon"
                    Width="10"
                    Height="10"
                    Stretch="None"
                    SnapsToDevicePixels="True"
                    Data="{StaticResource Glyph.WindowClose}"
                    Stroke="{DynamicResource TextSub}"
                    StrokeThickness="1.15"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Path.RenderTransform>
              </Path>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CloseIcon" Property="Stroke" Value="{DynamicResource OnDanger}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1"
                                       Duration="0:0:0.11">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"
                                       Duration="0:0:0.15">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CloseIcon" Property="Stroke" Value="{DynamicResource OnDanger}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1"
                                       Duration="0:0:0.06"/>
                      <DoubleAnimation Storyboard.TargetName="CloseIcon"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="0.9"
                                       Duration="0:0:0.06"/>
                      <DoubleAnimation Storyboard.TargetName="CloseIcon"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="0.9"
                                       Duration="0:0:0.06"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedFill"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"
                                       Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="CloseIcon"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="1"
                                       Duration="0:0:0.10"/>
                      <DoubleAnimation Storyboard.TargetName="CloseIcon"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="1"
                                       Duration="0:0:0.10"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </StackPanel>

    <!-- The one stroke the chrome keeps: its edge against the content. -->
    <Border Grid.ColumnSpan="2"
            Height="1"
            VerticalAlignment="Bottom"
            Background="{DynamicResource Divider}"/>
  </Grid>
</UserControl>
