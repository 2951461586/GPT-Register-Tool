<UserControl x:Class="SmsWorkbench.Views.WorkflowStepper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmsWorkbench.Views">
  <!-- Native WPF 3-step horizontal workflow indicator inspired by react-bits Stepper:
       numbered circles transition cleanly to checkmarks while connector tracks fill. -->
  <Border Background="{DynamicResource Surface.Card}"
          BorderBrush="{DynamicResource Divider}"
          BorderThickness="1"
          CornerRadius="{DynamicResource Corner.Lg}"
          Padding="14,9">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Step 1 -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="Step1Dot" Width="22" Height="22" CornerRadius="11" BorderThickness="1.5" VerticalAlignment="Center">
          <Grid>
            <TextBlock x:Name="Step1Num" Text="1" FontSize="{StaticResource Type.Micro.Size}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Path x:Name="Step1Check" Style="{StaticResource CompactIconPath}" Stroke="{DynamicResource OnPrimary}" StrokeThickness="2" Data="{StaticResource Glyph.Check}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <TextBlock x:Name="Step1Text"
                   Text="{Binding Step1Label, RelativeSource={RelativeSource AncestorType=local:WorkflowStepper}}"
                   FontSize="{StaticResource Type.Caption.Size}"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Track 1 -> 2 -->
      <Border Grid.Column="1" Height="2" Margin="12,0" CornerRadius="1" Background="{DynamicResource Surface.Block}" VerticalAlignment="Center" ClipToBounds="True">
        <Border x:Name="Track1Fill" HorizontalAlignment="Left" Background="{DynamicResource Primary}" Width="0"/>
      </Border>

      <!-- Step 2 -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="Step2Dot" Width="22" Height="22" CornerRadius="11" BorderThickness="1.5" VerticalAlignment="Center">
          <Grid>
            <TextBlock x:Name="Step2Num" Text="2" FontSize="{StaticResource Type.Micro.Size}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Path x:Name="Step2Check" Style="{StaticResource CompactIconPath}" Stroke="{DynamicResource OnPrimary}" StrokeThickness="2" Data="{StaticResource Glyph.Check}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <TextBlock x:Name="Step2Text"
                   Text="{Binding Step2Label, RelativeSource={RelativeSource AncestorType=local:WorkflowStepper}}"
                   FontSize="{StaticResource Type.Caption.Size}"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Track 2 -> 3 -->
      <Border Grid.Column="3" Height="2" Margin="12,0" CornerRadius="1" Background="{DynamicResource Surface.Block}" VerticalAlignment="Center" ClipToBounds="True">
        <Border x:Name="Track2Fill" HorizontalAlignment="Left" Background="{DynamicResource Primary}" Width="0"/>
      </Border>

      <!-- Step 3 -->
      <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="Step3Dot" Width="22" Height="22" CornerRadius="11" BorderThickness="1.5" VerticalAlignment="Center">
          <Grid>
            <TextBlock x:Name="Step3Num" Text="3" FontSize="{StaticResource Type.Micro.Size}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Path x:Name="Step3Check" Style="{StaticResource CompactIconPath}" Stroke="{DynamicResource OnPrimary}" StrokeThickness="2" Data="{StaticResource Glyph.Check}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <TextBlock x:Name="Step3Text"
                   Text="{Binding Step3Label, RelativeSource={RelativeSource AncestorType=local:WorkflowStepper}}"
                   FontSize="{StaticResource Type.Caption.Size}"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
