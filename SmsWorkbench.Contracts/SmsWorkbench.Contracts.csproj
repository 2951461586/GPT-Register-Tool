<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Keep in sync with SmsWorkbench.csproj: publishing restores with
         -r win-x64 while `dotnet test` restores without a RID. Declaring the
         RID here keeps the packages.lock.json RID set consistent with both,
         otherwise restore in locked mode fails with NU1004. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SmsWorkbench.Contracts</AssemblyName>
    <RootNamespace>SmsWorkbench</RootNamespace>
  </PropertyGroup>
</Project>
