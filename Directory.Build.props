<Project>
  <PropertyGroup>
    <!-- Pinned, not `latest-recommended`: an SDK upgrade must not silently add
         analyzer rules. Bumping this line is a deliberate commit whose diff
         `scripts/dotnet_warning_ratchet.py` shows: either the new rules report
         nothing, or their warnings are fixed / baselined in the same commit. -->
    <AnalysisLevel>10.0</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1605;NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <!-- Single source of truth for the assembly version. Overridable from the
         command line via -p:Version so the installer can stamp the git tag. -->
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
  </PropertyGroup>
</Project>
