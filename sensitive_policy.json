{
  "schema": "sensitive_policy.v1",
  "redacted_value": "[REDACTED]",
  "sensitive_keys": [
    "access_token", "accessToken", "refresh_token", "refreshToken", "id_token", "idToken",
    "oauth_refresh_token", "totp_secret", "totpSecret", "secret", "client_secret", "clientSecret",
    "api_key", "apiKey", "license_key", "licenseKey", "admin_token", "service_token", "session_token", "sessionToken",
    "cookie_header", "authorization", "card_number", "cardNumber", "card_cvv", "cardCvv",
    "cvv", "cvc", "blik_code", "ba_token", "payment_method_id", "password", "login_password",
    "checkout_session_id", "checkoutSessionId", "stripe_session_id", "cs_id",
    "payment_intent_id", "paymentIntentId", "stripe_payment_intent_id", "card_last4", "pan"
  ],
  "sensitive_key_fragments": ["token", "secret", "password", "card_number", "cardnumber", "card_last4", "authorization", "license_key"],
  "safe_key_suffixes": ["_status", "_count", "_hash", "_telemetry", "_present", "_enrolled"],
  "sensitive_options": [
    "--at", "--access-token", "--refresh-token", "--api-key", "--api-token",
    "--admin-token", "--client-secret", "--password", "--service-token",
    "--proxy", "--proxy-pool", "--checkout-proxy", "--provider-proxy", "--approve-proxy",
    "--promotion-proxy", "--stripe-init-proxy", "--payment-method-proxy",
    "--confirm-proxy", "--redirect-proxy", "--blik-code", "--mailbox-line"
  ],
  "text_patterns": [
    {"name":"proxy_credentials","pattern":"(?i)(\\b(?:https?|socks5h?)://)[^\\s/@]+@","replacement":"$1[REDACTED]@"},
    {"name":"bearer","pattern":"(?i)(\\bBearer\\s+)[A-Za-z0-9._~+/=-]+","replacement":"$1[REDACTED]"},
    {"name":"jwt","pattern":"\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{4,}\\b","replacement":"[REDACTED]"},
    {"name":"ba_token","pattern":"\\bBA-[A-Za-z0-9_.-]+\\b","replacement":"[REDACTED]"},
    {"name":"refresh_token","pattern":"(?i)\\brt_[A-Za-z0-9._~-]+\\b","replacement":"[REDACTED]"},
    {"name":"stripe_key","pattern":"(?i)\\b(?:sk|pk)_(?:live|test)_[A-Za-z0-9_-]+\\b","replacement":"[REDACTED]"},
    {"name":"named_secret","pattern":"(?i)(access[_-]?token|refresh[_-]?token|id[_-]?token|oauth[_-]?refresh[_-]?token|totp(?:[_-]?secret)?|client[_-]?secret|api[_-]?key|service[_-]?token|session[_-]?token|ba[_-]?token|blik[_-]?code|password|card(?:[_-]?(?:number|cvv|cvc|last4))?|authorization)(\\s*[=:]\\s*)[\"']?([^\\s,}\"']+)[\"']?","replacement":"$1$2[REDACTED]"}
  ]
}
